(ns xsofy.render
  (:require [term]
            [clojure.string :as str]
            [math]
            [xsofy.terrain :as terrain]
            [xsofy.entities :as ent]
            [xsofy.combat :as combat]
            [xsofy.util :as u]
            [xsofy.lighting :as light]
            [xsofy.effects :as fx]
            [xsofy.status :as status]
            [xsofy.runes :as runes]
            [xsofy.input :as input]
            [xsofy.screenfx :as sfx]
            [xsofy.gentick :as gt]
            [xsofy.ui :as ui]
            [clojure.string :as cstr]))

;; --- Color Helpers ---

(def dim-color u/scale)

;; Terminal dimensions, headless-safe. term/size is nil with no TTY (CI/tests)
;; and momentarily nil during a resize — both yielded a nil destructure and a
;; blank/garbled redraw. Fall back to the game's nominal size.
(defn term-dims []
  (or (term/size) [ui/game-width ui/game-height]))

;; --- Tile Rendering ---

(defn style-tile [tile]
  (get terrain/tile-styles tile {:fg [80 80 80] :bg [10 10 10]}))

;; --- Memory ---
;; Remembered tiles are dimmed with a cool blue-gray tint

(defn memory-color [rgb]
  (let [[r g b] rgb]
    [(int (* r 0.3))
     (int (* g 0.3))
     (u/clamp8 (* b 0.4))]))

;; --- Map Panel ---

(def cell-hash u/cell-hash)
(def jitter-color u/jitter)

;; dancing tiles: water and lava get randomized color each frame
(def dancing-tiles #{3 4 7})

;; --- Camera ---
;; The map rect on a narrow terminal is smaller than the world (e.g. 27x17
;; visible vs 79x30 in xsofy). Without an offset, world-coord renders
;; that land outside the rect are silently dropped — including the player.
;; The fix: attach a camera offset (:cx :cy) to the map rect, centered on
;; the player and clamped to world bounds. render-map-tile and friends
;; consume the offset via map-cell, so callers keep passing world coords.

;; Dead-zone camera state. Camera moves with the player only when the
;; player is within MARGIN cells of the visible window's edge; otherwise
;; the camera holds its last committed position. This turns most player
;; moves into FOV-delta renders (cheap) instead of full-window repaints
;; (~1300 cells, ~0.14ms/cell on WASM = the dominant render-side spike).
;;
;; The atom stores {:cx :cy :depth} so a floor change forces a recenter:
;; the new floor's coordinate system has no relation to the old one.
;;
;; Render-only state; safe as an atom because the render path is
;; single-threaded (the WASM Go runtime is, and the native path runs in
;; the main game thread).
(def last-camera (atom nil))

;; --- SGR pen (render-perf: lossless set-fg/set-bg elision) ---
;; let-go's `term` is a raw-emit primitive — every set-fg/set-bg writes an SGR
;; escape immediately, so the map loop re-sends identical fg/bg for every cell
;; even across long same-color runs (walls, memory, blanked cells). SGR
;; attributes persist across cursor moves, so re-emitting an unchanged color is
;; pure waste — bytes on native, and a Go→JS→xterm.js crossing per call on WASM.
;;
;; The pen records the last fg/bg we emitted and skips a set-fg/set-bg whose
;; color already matches. move-cursor and write are untouched, so this is
;; lossless: identical glyphs, identical colors, just fewer escapes.
;;
;; Correctness: the pen mirrors the terminal's current fg/bg, valid only while
;; every styled write goes through pen-fg!/pen-bg!. Any raw set-fg/set-bg /
;; reset-style / screen blank (panels, vfx overlays, the full-clear) leaves it
;; stale, so each contiguous penned batch (render-map, the render-dirty delta
;; loop, restore-dirty-cells!) calls pen-reset! before its first cell. nil =
;; "unknown" → always emit. Render-only state; single-threaded like last-camera.
(def sgr-pen (atom nil))

(defn pen-reset! []
  (reset! sgr-pen nil))

(defn pen-fg! [r g b]
  (let [c [r g b]]
    (when (not= (:fg @sgr-pen) c)
      (term/set-fg r g b)
      (swap! sgr-pen assoc :fg c))))

(defn pen-bg! [r g b]
  (let [c [r g b]]
    (when (not= (:bg @sgr-pen) c)
      (term/set-bg r g b)
      (swap! sgr-pen assoc :bg c))))

;; Synchronized output (DEC 2026) lives in xsofy.screenfx now (shared with the
;; title/descent screens). Full-screen frames wrap their emit body in
;; (sfx/with-frame ...), which opens the sync and always closes it (end-sync +
;; flush) via finally — so a frame can't leave the sync mode dangling.

;; --- Appearance buffer (render-perf: skip frame-to-frame unchanged cells) ---
;; The real per-move waste isn't redundant same-color runs (SGR elision above
;; barely fires — per-cell lighting + jitter make neighbors distinct); it's that
;; render-dirty re-emits the ENTIRE visible FOV every move even though lights are
;; static terrain sources, so most visible cells are byte-identical to last
;; frame. This buffer records each world cell's last drawn appearance
;; [ch fr fg fb br bg bb]; render-map-tile skips a cell whose appearance is
;; unchanged. Animated tiles (dancing water/lava, fire — randomized each frame)
;; naturally differ and still redraw; static stone/floor/wall away from the move
;; drop out.
;;
;; Keyed by WORLD [x y] (not screen position) so it survives nothing — a camera
;; shift moves every cell on screen, so the buffer MUST be cleared then (else a
;; cell whose color is unchanged but whose screen position moved would be
;; skipped and never drawn at its new spot). render-map clears it, and render-map
;; runs on exactly the full-repaint cases (render-full, camera shift, floor
;; change, resize). The FOV-delta path does not clear it, so the diff stays live.
(def cell-appearance (atom {}))

;; Dead-zone as a fraction of the EFFECTIVE viewport, per axis. The camera
;; holds while the player roams this central box; crossing it scrolls the
;; camera 1 cell/step to keep the player on the boundary (clamped at the
;; world edge). Fractional (not fixed cells) so the feel stays constant as
;; the terminal resizes. Smaller frac = tighter box = more centered = more
;; forward look-ahead + more scrolling. 0 ⇒ always-centered (option 3).
;; Cells are ~2.3x taller than wide, so horizontal runs looser than vertical.
(def deadzone-pct-x 60)
(def deadzone-pct-y 35)

(defn- deadzone-margin
  "Half-margin in cells for a dead-zone covering `pct`% of `eff` cells.
   Capped at eff/2 so the zone can't invert on tiny viewports (collapses
   to pure-centering instead)."
  [pct eff]
  (min (quot eff 2)
       (quot (* eff (- 100 pct)) 200)))

(defn- center-camera
  "Centered-on-player offset, clamped to world bounds. Used on first
   render of a floor and as a fallback when no last-camera is stored."
  [ww wh rw rh px py]
  [(if (<= ww rw) 0 (max 0 (min (- ww rw) (- px (quot rw 2)))))
   (if (<= wh rh) 0 (max 0 (min (- wh rh) (- py (quot rh 2)))))])

(defn camera-for
  "Dead-zone camera for map rect r. If the player is at least the dead-zone
   margin (deadzone-margin) from each edge of the previously-committed camera
   window, returns the previous camera unchanged — the FOV-delta render
   path then writes only the cells that actually changed. Otherwise the
   camera shifts just enough to put the player that margin from whichever
   edge they were crossing.

   On first render of a floor (no last-camera, or different :depth), the
   camera centers on the player."
  [world r]
  (let [ww (or (:width world) 0)
        wh (or (:height world) 0)
        rw (:w r)
        rh (:h r)
        [px py] (or (get-in world [:entities :player :pos]) [0 0])
        cur-depth (:depth world)
        stored @last-camera
        ;; Floor change OR viewport resize triggers a recenter. Storing
        ;; rect dimensions in last-camera lets the next render detect a
        ;; font-size cycle (xterm refits → new cols/rows → new rw/rh)
        ;; and re-center the camera on the player instead of holding the
        ;; previous offset inside a now-different-sized window.
        valid? (and stored
                    (= cur-depth (:depth stored))
                    (= rw        (:rw stored))
                    (= rh        (:rh stored)))
        [prev-cx prev-cy] (if valid?
                            [(:cx stored) (:cy stored)]
                            (center-camera ww wh rw rh px py))
        rel-x (- px prev-cx)
        rel-y (- py prev-cy)
        ;; Proportional dead-zone half-margin. deadzone-margin caps at rw/2
        ;; (resp. rh/2), so the two cond branches below never overlap and
        ;; the camera can't oscillate / leave a ghost row on small viewports.
        mx (deadzone-margin deadzone-pct-x rw)
        my (deadzone-margin deadzone-pct-y rh)
        new-cx (cond
                 (<= ww rw)             0
                 (< rel-x mx)           (max 0 (- px mx))
                 (>= rel-x (- rw mx))   (min (- ww rw) (- (+ px mx) rw))
                 :else                  prev-cx)
        new-cy (cond
                 (<= wh rh)             0
                 (< rel-y my)           (max 0 (- py my))
                 (>= rel-y (- rh my))   (min (- wh rh) (- (+ py my) rh))
                 :else                  prev-cy)]
    [new-cx new-cy]))

(defn with-camera
  "Attach a camera-for offset to the map rect. Callers pass the result
   anywhere a map rect is consumed. Pure read — does NOT advance the
   stored camera; render-full / render-dirty call commit-camera! once
   after using the rect, so callers like animate-vfx! don't accidentally
   change the camera between turns."
  [world r]
  (let [[cx cy] (camera-for world r)]
    (assoc r :cx cx :cy cy)))

(defn commit-camera!
  "Persist the camera offset on rect mr as the new baseline for future
   camera-for calls. Stores depth and rect dimensions alongside — depth
   change triggers recenter on floor change; rect-dim change triggers
   recenter on viewport resize (font cycle, window resize)."
  [world mr]
  (reset! last-camera {:cx    (:cx mr)
                       :cy    (:cy mr)
                       :depth (:depth world)
                       :rw    (:w mr)
                       :rh    (:h mr)}))

(defn reset-camera!
  "Drop any stored camera so the next render centers on the player. Called at
   run construction (assemble-world) so a new run never inherits the prior
   run's offset — camera validity keys only on depth + viewport dims, so a
   same-depth, same-viewport restart otherwise reuses the stale camera."
  []
  (reset! last-camera nil))

(defn map-cell
  "Translate world (x y) → terminal [col row] for map rect r, honoring
   the rect's camera offset (:cx :cy, default 0). Returns nil if the
   cell falls outside the visible window."
  [r x y]
  (let [cx (or (:cx r) 0)
        cy (or (:cy r) 0)
        tx (- x cx)
        ty (- y cy)]
    (when (and (>= tx 0) (< tx (:w r))
               (>= ty 0) (< ty (:h r)))
      [(+ (:x r) tx) (+ (:y r) ty)])))

(defn- tile-appearance
  "Pure: the [ch fr fg fb br bg bb] a cell should display this frame. Animated
   tiles use rand-int, so their appearance differs every call by design."
  [x y tile visible remembered light-val stain gas]
  (cond
    visible
      (let [style (style-tile tile)
            ch (get terrain/tile-chars tile "?")
            ;; per-tile color variation
            fg0 (cond
                  ;; fire: random flickering
                  (= tile 15) [(+ 200 (rand-int 55)) (+ 80 (rand-int 100)) (rand-int 40)]
                  ;; grass: moderate jitter
                  (= tile 2) (jitter-color (:fg style) x y 20)
                  ;; water/lava: dancing colors (randomized each frame, big variation)
                  (= tile 3) (let [[r g b] (:fg style)]
                               [(max 0 (+ r (- (rand-int 30) 15)))
                                (max 0 (+ g (- (rand-int 30) 15)))
                                (max 0 (+ b (- (rand-int 40) 20)))])
                  (= tile 4) (let [[r g b] (:fg style)]
                               [(max 0 (+ r (- (rand-int 20) 10)))
                                (max 0 (+ g (- (rand-int 20) 10)))
                                (max 0 (+ b (- (rand-int 30) 15)))])
                  (= tile 7) (let [[r g b] (:fg style)]
                               [(max 0 (+ r (- (rand-int 50) 25)))
                                (max 0 (+ g (- (rand-int 40) 20)))
                                (max 0 (+ b (rand-int 15)))])
                  ;; all other tiles: subtle deterministic jitter
                  :else (jitter-color (:fg style) x y 6))
            bg0 (cond
                  (= tile 15) [(+ 80 (rand-int 60)) (+ 20 (rand-int 30)) (rand-int 15)]
                  (= tile 2) (jitter-color (:bg style) x y 8)
                  (= tile 3) (let [[r g b] (:bg style)]
                               [(max 0 (+ r (- (rand-int 15) 7)))
                                (max 0 (+ g (- (rand-int 15) 7)))
                                (max 0 (+ b (- (rand-int 25) 12)))])
                  (= tile 4) (let [[r g b] (:bg style)]
                               [(max 0 (+ r (- (rand-int 10) 5)))
                                (max 0 (+ g (- (rand-int 10) 5)))
                                (max 0 (+ b (- (rand-int 20) 10)))])
                  (= tile 7) (let [[r g b] (:bg style)]
                               [(max 0 (+ r (- (rand-int 40) 20)))
                                (max 0 (+ g (- (rand-int 20) 10)))
                                (max 0 (+ b (rand-int 8)))])
                  :else (jitter-color (:bg style) x y 3))]
        ;; apply stain (fg stronger tint), gas, lighting
        (let [stain-int (if (and stain (map? stain)) (or (:intensity stain) 1) 0)
              fg1 (if (> stain-int 0)
                    (fx/stain-tint-fg fg0 (:type stain) (* stain-int 2) x y)
                    fg0)
              bg1 (if (> stain-int 0)
                    (fx/stain-tint-bg bg0 (:type stain) stain-int x y)
                    bg0)
              fg1 (if gas (fx/gas-tint fg1 gas) fg1)
              bg2 (if gas (fx/gas-tint bg1 gas) bg1)]
          (let [[fr fg fb] (light/apply-light fg1 (or light-val [0 0 0]))
                [br bgg bb] (light/apply-light bg2 (or light-val [0 0 0]))]
            [ch fr fg fb br bgg bb])))

      remembered
      (let [style (style-tile remembered)
            ch (get terrain/tile-chars remembered "?")
            [fr fg fb] (memory-color (:fg style))
            [br bgg bb] (memory-color (:bg style))]
        [ch fr fg fb br bgg bb])

      :else
      (let [[br bgg bb] ui/bg]
        [" " br bgg bb br bgg bb])))

(defn- draw-cell!
  "Draw appearance `app` at world cell [x y], unless the screen already shows
   exactly that (see cell-appearance)."
  [r x y app]
  (when-let [[col row] (map-cell r x y)]
    (when (not= app (get @cell-appearance [x y]))
      (let [[ch fr fg fb br bgg bb] app]
        (term/move-cursor col row)
        (pen-fg! fr fg fb)
        (pen-bg! br bgg bb)
        (term/write ch))
      (swap! cell-appearance assoc [x y] app))))

;; --- Light lookup ---
;; :lights holds terrain lights only (torches, lava, fire), cached on the world;
;; fire.lg drops it whenever terrain changes and update-fov rebuilds it. So the
;; light at a cell is fixed until :lights is replaced, and summing every source
;; per drawn cell (light-at) redid the same work on every draw: cells x lights,
;; slow on floors with many torches. The grid is built once per :lights value.
(def ^:private light-cache (atom nil))

(defn- light-of
  "light/light-at x y over the world's lights, read from the per-floor grid."
  [world x y]
  (let [lights (:lights world)
        w (:width world)]
    (if (empty? lights)
      [0 0 0]
      (let [c @light-cache
            grid (if (and c (identical? (:src c) lights) (= (:w c) w))
                   (:grid c)
                   (let [g (light/light-grid lights w (:height world))]
                     (reset! light-cache {:src lights :w w :grid g})
                     g))]
        (nth grid (+ x (* y w)))))))

(defn render-map-tile [r x y tile visible remembered light-val stain gas]
  (draw-cell! r x y (tile-appearance x y tile visible remembered light-val stain gas)))

(defn render-map [world r]
  (let [{:keys [terrain width height fov memory]} world
        stains (or (:stains world) {})
        gases (or (:gases world) {})
        cx (or (:cx r) 0)
        cy (or (:cy r) 0)]
    (pen-reset!)   ; start of a contiguous penned batch (see sgr-pen)
    ;; render-map is the full-repaint path (render-full, camera shift, floor
    ;; change, resize). Drop the appearance buffer so every cell redraws over the
    ;; freshly-blanked/scrolled screen; it repopulates as we draw. The FOV-delta
    ;; path never calls render-map, so there the buffer persists and the diff runs.
    (reset! cell-appearance {})
    ;; Walk screen cells and translate back to world coords, so we cover the
    ;; visible world window [cx, cx+w) × [cy, cy+h) (clamped to the map). The
    ;; old world-origin range [0, w) × [0, h) missed every on-screen cell once
    ;; the camera scrolled (cx/cy > 0), leaving narrow viewports with entities
    ;; drawn but no terrain.
    (dotimes [sy (:h r)]
      (dotimes [sx (:w r)]
        (let [x (+ cx sx)
              y (+ cy sy)]
          (when (and (>= x 0) (< x width) (>= y 0) (< y height))
            (let [visible (contains? fov [x y])
                  remembered (get memory [x y])
                  tile (when visible (terrain/tget terrain width x y))
                  lv (when visible (light-of world x y))
                  stain (when visible (get stains [x y]))
                  gas (when visible (get gases [x y]))]
              (render-map-tile r x y tile visible remembered lv stain gas))))
        ;; Hands the thread back when the arrival captures a frame under the
        ;; descent (capture-frame); a no-op otherwise.
        (gt/tick! :render-row)))))

(defn entity-z-priority
  "Z-order weight for entities sharing a cell — higher wins.
   Player > creature > item. Mirrors render-map-entities' draw order."
  [e]
  (cond
    (= :player (:id e))         3
    (= :item (:entity-type e))  1
    :else                       2))

;; Cyan-blue — stays clear of player gold, hostile red, goblin green,
;; fire-orange.
(def friendly-tint [120 200 255])

(defn- entity-appearance
  "[glyph fr fg fb br bg bb] for `entity` on its tile, or nil when it isn't
   in view."
  [world r entity]
  (when-let [pos (:pos entity)]
    (let [{:keys [fov]} world
          [x y] pos]
      (when (and (contains? fov [x y])
                 (map-cell r x y))
        (let [tile (terrain/tget (:terrain world) (:width world) x y)
              tile-bg (:bg (style-tile tile))
              stains (or (:stains world) {})
              stain (get stains [x y])
              lv (light-of world x y)
              ;; stain tints the bg only (entity sits on top)
              bg0 (if (and stain (map? stain))
                    (fx/stain-tint-bg tile-bg (:type stain) (or (:intensity stain) 1) x y)
                    tile-bg)
              bg-lit (if lv (light/apply-light bg0 lv) bg0)
              ;; friendly tint first so an ally on fire still reads as
              ;; burning, then status tint.
              base-fg (get-in entity [:visual :color] [200 60 60])
              friendly-fg (if (:friendly entity)
                            (let [[br bg bb] base-fg
                                  [fr fgc fb] friendly-tint]
                              [(quot (+ br fr) 2)
                               (quot (+ bg fgc) 2)
                               (quot (+ bb fb) 2)])
                            base-fg)
              stint (status/entity-status-tint entity)
              fg0 (if stint
                    (let [[sc _] stint
                          [br bg bb] friendly-fg
                          [sr sg sb] sc]
                      [(quot (+ br sr) 2) (quot (+ bg sg) 2) (quot (+ bb sb) 2)])
                    friendly-fg)
              bg1 (if stint
                    (let [[_ sbg] stint
                          [br bg bb] bg-lit
                          [sr sg sb] sbg]
                      [(quot (+ br sr) 2) (quot (+ bg sg) 2) (quot (+ bb sb) 2)])
                    bg-lit)
              fg-lit (if lv (light/apply-light fg0 lv) fg0)
              glyph (get-in entity [:visual :glyph] "?")
              [fr fg fb] fg-lit
              [br bgg bb] bg1]
          [glyph fr fg fb br bgg bb])))))

;; Entities go through the appearance buffer like tiles do, and each cell is
;; drawn once with what ends up on top. Painting the tile and then the entity
;; over it every turn rewrote every visible creature and item, and a frame shown
;; between the two writes blanked them to bare floor.
;; Where the player was last drawn, and how: {:pos [x y] :app [...]}. A killed
;; player is removed from the world, so the death fade reads this to close in
;; on the right cell (render-side only; the world is untouched).
(def last-player-drawn (atom nil))

(defn- note-player! [entity app]
  (when (= :player (:id entity))
    (reset! last-player-drawn {:pos (:pos entity) :app app})))

(defn render-entity [world r entity]
  (when-let [app (entity-appearance world r entity)]
    (let [[x y] (:pos entity)]
      (note-player! entity app)
      (draw-cell! r x y app))))

(defn top-entities
  "{pos -> entity} for every entity in view, keeping the one drawn on top
   where several share a cell (player > creature > item)."
  [world]
  (let [fov (or (:fov world) #{})]
    (core/reduce (fn [m e]
                   (let [pos (:pos e)]
                     (if (and pos (contains? fov pos)
                              (let [prev (get m pos)]
                                (or (nil? prev) (< (entity-z-priority prev) (entity-z-priority e)))))
                       (assoc m pos e)
                       m)))
                 {} (vals (:entities world)))))

(defn- render-cell!
  "Draw world cell [x y] as it should finally look: the top entity in `top`
   if one stands there, else the tile (lit if in view, remembered if not)."
  [world r top x y]
  (if-let [app (when-let [e (get top [x y])]
                 (when-let [app (entity-appearance world r e)]
                   (note-player! e app)
                   app))]
    (draw-cell! r x y app)
    (let [visible (contains? (:fov world) [x y])]
      (render-map-tile r x y
                       (when visible (terrain/tget (:terrain world) (:width world) x y))
                       visible
                       (get (:memory world) [x y])
                       (when visible (light-of world x y))
                       (when visible (get (:stains world) [x y]))
                       (when visible (get (:gases world) [x y]))))))

(defn render-map-entities [world r]
  ;; only the top entity of each cell (player > creature > item), so an item
  ;; under a monster isn't drawn and then drawn over
  (doseq [[_ e] (top-entities world)] (render-entity world r e)))

;; --- Sidebar Panel ---

;; --- Status bar colors per effect type ---
(def status-bar-colors
  {:burning  {:fill [180 60 10]  :empty [50 15 5]}
   :frozen   {:fill [60 100 200] :empty [15 25 50]}
   :poison   {:fill [40 150 40]  :empty [10 35 10]}
   :webbed   {:fill [160 160 170] :empty [35 35 38]}
   :swimming {:fill [40 80 150]  :empty [10 20 40]}
   :slowed   {:fill [100 100 140] :empty [25 25 35]}
   :confused {:fill [150 60 180] :empty [35 15 40]}
   :haste    {:fill [200 200 60] :empty [45 45 12]}})

(defn render-status-bars
  "Render status effect bars starting at row. Returns next row."
  [r row entity]
  (let [statuses (status/entity-active-statuses entity)]
    (core/reduce (fn [row s]
              (if (>= row (:h r)) row
                (let [colors (get status-bar-colors (:stype s)
                               {:fill [120 120 120] :empty [30 30 30]})
                      max-ttl (:max-ttl s)
                      ttl (:ttl s)]
                  (ui/bar r row (str " " (:name s))
                          ttl max-ttl
                          (:fill colors) (:empty colors) (:color s))
                  (inc row))))
            row statuses)))

(defn render-creature-entry
  "Render a creature entry at row. Returns next row."
  [r row c]
  (let [chp (or (get-in c [:body :hp]) 0)
        cmhp (or (get-in c [:body :max-hp]) 1)
        tpl (:template c)
        eid (:id c)
        cname (if tpl (name tpl) (if eid (name eid) "???"))
        ally-tag (if (:friendly c) " (ally)" "")
        color (if (:friendly c)
                friendly-tint
                (or (get-in c [:visual :color]) [200 60 60]))
        glyph (or (get-in c [:visual :glyph]) "?")]
    (when (< (+ row 1) (:h r))
      (ui/write-line r row (str " " glyph " " cname ally-tag) color ui/bg)
      (let [row (inc row)]
        (ui/bar r row (str " " chp "/" cmhp)
                chp cmhp
                [140 30 30] [40 12 12] [180 150 130])
        (render-status-bars r (inc row) c)))))

;; What the sidebar last drew, as the values it reads. Every turn calls
;; render-sidebar, but most turns change nothing in it, and a clear-and-redraw
;; of the whole column shows as flicker and costs output. Reset wherever the
;; screen under it was blanked (render-full, close-panel!).
(def ^:private sidebar-drawn (atom nil))

(defn- sidebar-visible-creatures [world]
  (let [fov (or (:fov world) #{})]
    (->> (vals (:entities world))
         (filter (fn [e]
                   (and (some? e) (map? e) (:id e)
                        (not= :player (:id e))
                        (:pos e)
                        (some? (get-in e [:body :hp]))
                        (contains? fov (:pos e)))))
         (vec)
         (sort-by (fn [e] (or (get-in e [:body :hp]) 0))))))

(defn- sidebar-key
  "Everything render-sidebar shows, minus what it doesn't (a creature's
   position), so a turn where nothing in the column changed compares equal."
  [world r creatures]
  (let [player (get-in world [:entities :player])
        shown (fn [e] [(:id e) (:template e) (:friendly e) (:visual e)
                       (get-in e [:body :hp]) (get-in e [:body :max-hp])
                       (status/entity-active-statuses e)])]
    [r (:body player) (status/entity-active-statuses player)
     (ent/get-weapon world :player) (ent/get-armor world :player)
     (:gold world) (:depth world) (:seed-input world)
     (mapv shown creatures)]))

(defn render-sidebar [world r]
  (when r
   (let [creatures (sidebar-visible-creatures world)
         k (sidebar-key world r creatures)]
    (when (not= k @sidebar-drawn)
    (reset! sidebar-drawn k)
    (ui/clear-rect r)
    (when-let [player (get-in world [:entities :player])]
    (let [hp (or (get-in player [:body :hp]) 0)
          max-hp (or (get-in player [:body :max-hp]) 1)
          str_ (or (get-in player [:body :strength]) 0)
          wep (ent/get-weapon world :player)
          arm (ent/get-armor world :player)
          wep-name (if wep (or (:item-name wep) "weapon") "fists")
          arm-name (if arm (or (:item-name arm) "armor") "none")
          dmg-str (if wep
                    (str (get-in wep [:item :min-dmg] 1) "-" (get-in wep [:item :max-dmg] 2))
                    "1-2")
          ;; compute effective defense: base armor def + enchant scaling + strength modifier
          arm-def (if arm (or (get-in arm [:item :defense]) 0) 0)
          arm-enchant (if arm (or (get-in arm [:item :enchant]) 0) 0)
          arm-req (if arm (or (get-in arm [:item :str-req]) 1) 1)
          arm-net (+ arm-enchant (combat/strength-modifier str_ arm-req))
          def-val (+ (get-in player [:body :armor] 0) arm-def (int (* arm-net 10)))
          row (atom 0)]
      ;; player header + HP bar
      (ui/write-line r @row " @ You" [255 220 80] ui/bg)
      (swap! row inc)
      (ui/bar r @row (str " HP " hp "/" max-hp)
              hp max-hp
              [140 30 30] [40 12 12] [220 180 160])
      (swap! row inc)
      ;; stats
      (ui/write-line r @row (str " Str " str_ "  Def " def-val) [140 130 110] ui/bg)
      (swap! row inc)
      ;; player status bars — dynamic zone between core stats and equipment, so
      ;; transient effects (frozen/poison/…) don't shove the always-present
      ;; HP/Str lines around every tick.
      (reset! row (render-status-bars r @row player))
      (ui/write-line r @row (str " " wep-name " (" dmg-str ")") [160 160 180] ui/bg)
      (swap! row inc)
      (ui/write-line r @row (str " " arm-name) [140 130 110] ui/bg)
      (swap! row inc)
      ;; gold
      (let [gold (or (:gold world) 0)]
        (when (> gold 0)
          (ui/write-line r @row (str " Gold " gold) [255 220 50] ui/bg)
          (swap! row inc)))
      ;; depth
      (ui/write-line r @row (str " Depth " (:depth world)) [100 100 100] ui/bg)
      (swap! row inc)
      ;; seed — enables ?seed= reproducible runs (#44)
      (ui/write-line r @row (str " Seed " (:seed-input world)) [80 80 95] ui/bg)
      (swap! row inc)
      ;; separator
      (ui/write-line r @row (apply str (repeat (:w r) "-")) [40 40 40] ui/bg)
      (swap! row inc)
      ;; visible creatures
      (doseq [c creatures]
        (when (< @row (:h r))
          (let [next-row (render-creature-entry r @row c)]
            (reset! row (or next-row (+ @row 2))))))))))))

;; --- Top Bar (narrow-width HP/status; replaces the folded sidebar) ---
;; One row, left-aligned (it does NOT fill the width): a fixed-width HP bar
;; using the same width + colors as the sidebar's, then status-effect badges,
;; then depth. Renders in the terminal grid, so native TUI and WASM get it
;; identically — the browser chrome HUD is no longer HP's only home.

;; Status badge: a 3-char tag ("poi", "bur"), painted on the effect's own bg
;; color so the color carries the signal. A one-cell-per-effect variant for
;; ultra-narrow rows can come later as an automatic overflow fallback.
(defn- topbar-badge-text [st]
  (let [nm (:name st)]
    (subs nm 0 (min 3 (count nm)))))

(defn render-topbar [world r]
  (when r
    (ui/clear-rect r)
    (when-let [player (get-in world [:entities :player])]
      (let [hp     (or (get-in player [:body :hp]) 0)
            max-hp (or (get-in player [:body :max-hp]) 1)
            ;; HP bar: same width + palette the sidebar uses, left-aligned.
            hp-w    (min ui/sidebar-width (:w r))
            hp-rect (assoc r :w hp-w)]
        (ui/bar hp-rect 0 (str " HP " hp "/" max-hp)
                hp max-hp [140 30 30] [40 12 12] [220 180 160])
        ;; Badges, then depth, flowed left→right after the HP bar. Each badge
        ;; is clipped out (not truncated) if it won't fit whole.
        (let [statuses (status/entity-active-statuses player)
              gap 1
              y (:y r)
              right (+ (:x r) (:w r))]
          (loop [col (+ (:x r) hp-w gap) ss statuses]
            (if (seq ss)
              (let [st  (first ss)
                    txt (topbar-badge-text st)
                    w   (count txt)]
                (if (<= (+ col w) right)
                  (let [[fr fg fb] (:color st)
                        [br bg bb] (or (get-in status/status-defs [(:stype st) :bg]) [30 30 30])]
                    (term/move-cursor col y)
                    (term/set-fg fr fg fb)
                    (term/set-bg br bg bb)
                    (term/write txt)
                    (recur (+ col w gap) (rest ss)))
                  ;; This badge is clipped whole; later badges won't fit either.
                  ;; Stop advancing so the depth tag can still use the space the
                  ;; badge couldn't — a shorter "D1" may fit where "poi" didn't.
                  (recur col nil)))
              ;; depth tag after the badges (or after the first clipped badge)
              (let [dtxt (str "D" (:depth world))]
                (when (<= (+ col (count dtxt)) right)
                  (let [[br bg bb] ui/bg]
                    (term/move-cursor col y)
                    (term/set-fg 120 120 120)
                    (term/set-bg br bg bb)
                    (term/write dtxt)))))))))))

;; --- Log Panel ---

(defn format-log-entry [entry]
  (if (map? entry)
    (str (:msg entry) " (x" (:count entry) ")")
    (str entry)))

(defn wrap-text
  "Lines of at most w chars, broken at spaces; a word longer than a line is
   cut. Lines after the first start with a space, so a wrapped message hangs
   one in under its first line."
  [s w]
  (let [w (max 2 w)]
    (loop [words (remove empty? (cstr/split (str s) #" "))
           line nil
           out []]
      (if-let [word (first words)]
        (let [lead (if (empty? out) "" " ")
              cap (- w (count lead))]
          (cond
            (nil? line)
            (if (> (count word) cap)
              (recur (cons (subs word cap) (rest words)) nil
                     (conj out (str lead (subs word 0 cap))))
              (recur (rest words) word out))

            (<= (+ (count line) 1 (count word)) cap)
            (recur (rest words) (str line " " word) out)

            :else
            (recur words nil (conj out (str lead line)))))
        (if line
          (conj out (str (if (empty? out) "" " ") line))
          (if (empty? out) [""] out))))))

(defn log-lines
  "The log as display lines, [{:text :entry} ...], oldest first: each entry
   wrapped to w, or one line each when w is nil."
  [log w]
  (vec (mapcat (fn [i entry]
                 (let [msg (format-log-entry entry)]
                   (map (fn [t] {:text t :entry i})
                        (if w (wrap-text msg w) [msg]))))
               (range) log)))

;; The log screen is a centred panel: the inventory's width, three quarters of
;; the terminal's height but never under 12 rows, so it reads as a window over
;; the game rather than a page that replaces it.
(def ^:private messages-panel-w 76)

(defn messages-panel-h [term-height]
  (min (- term-height 2) (max 12 (quot (* 3 term-height) 4))))

(defn message-visible-lines
  "Log rows the panel shows: its height less the border, the blank row inside
   it at top and bottom, and the footer."
  [term-height]
  (max 1 (- (messages-panel-h term-height) 2 ui/panel-pad-rows 1)))

(defn message-text-w
  "Chars of message per log-window row: the panel's inner width less the
   leading space."
  [term-width]
  (- (min messages-panel-w (- term-width 2)) 2 1))

(defn message-log-window
  "The slice of the log the window shows. Scrolling counts display lines, so
   with a width each entry may take several; :start/:end/:count stay in
   entries, for the footer."
  ([log visible-lines scroll-offset]
   (message-log-window log visible-lines scroll-offset nil))
  ([log visible-lines scroll-offset width]
   (let [log (vec (or log []))
         lines (log-lines log width)
         n (count lines)
         visible-lines (max 1 visible-lines)
         max-scroll (max 0 (- n visible-lines))
         scroll (min (max 0 (or scroll-offset 0)) max-scroll)
         end-line (- n scroll)
         shown (subvec lines (max 0 (- end-line visible-lines)) end-line)
         start-idx (if (seq shown) (:entry (first shown)) 0)
         end-idx (if (seq shown) (inc (:entry (peek shown))) 0)]
     {:lines shown
      :entries (subvec log start-idx end-idx)
      :start start-idx
      :end end-idx
      :count (count log)
      :scroll scroll
      :max-scroll max-scroll})))

(defn max-message-scroll [world visible-lines]
  (let [[tw _] (term-dims)]
    (:max-scroll (message-log-window (:log world) visible-lines (:message-scroll world)
                                     (message-text-w tw)))))

;; Rune glyphs in a message ("You learn: ᛇ means ...") take the runestone's
;; glow, faded with the line like the rest of it. Messages are plain strings,
;; so the colour is applied when the line is drawn.
(def ^:private rune-chars (into (set runes/rune-glyphs) (vals runes/numeral-glyphs)))
(def ^:private rune-color [180 140 255])

(defn- write-message-line!
  "ui/write-line, then any rune glyphs in text redrawn in rune-color, scaled
   by the line's own brightness (fg's red channel, out of 220)."
  [r y text fg bgc]
  (ui/write-line r y text fg bgc)
  (let [k (min 1.0 (/ (first fg) 220.0))
        c (mapv #(int (* % k)) rune-color)]
    (doseq [[i ch] (keep-indexed (fn [i ch] (when (contains? rune-chars (str ch)) [i (str ch)]))
                                 text)
            :when (< i (:w r))]
      (ui/write-at r i y ch c bgc))))

(defn render-log [world r]
  (when r
    (ui/clear-rect r)
    (let [log (vec (or (:log world) []))
          n (:h r)
          ;; n entries always cover n rows; wrapping only makes them longer
          recent (if (> (count log) n) (subvec log (- (count log) n)) log)
          lines (log-lines recent (- (:w r) 1))
          lines (if (> (count lines) n) (subvec lines (- (count lines) n)) lines)
          cnt (count lines)
          newest (dec (count recent))]
      (dotimes [i cnt]
        (let [{:keys [text entry]} (nth lines i)
              age (- newest entry)
              brightness (max 60 (- 220 (* age 50)))]
          (write-message-line! r (+ (- n cnt) i) (str " " text)
                               [brightness
                                (max 60 (- brightness 20))
                                (max 40 (- brightness 80))]
                               ui/bg))))))

;; --- VFX Rendering ---
;; line-cells lives in xsofy.util now (use u/line-cells).

(def boost-color u/lerp)

(defn vfx-dirty-cells
  "Collect the set of [x y] cells touched by the current vfx frame."
  [vfx]
  (loop [events vfx dirty #{}]
    (if (empty? events)
      dirty
      (let [event (first events)
            cells (case (:type event)
                    :bolt (let [[x0 y0] (:from event)
                                [x1 y1] (:to event)]
                            (u/line-cells x0 y0 x1 y1))
                    :projectile (let [path (or (:path event) [])
                                      step (or (:step event) 0)]
                                  (if (< step (count path))
                                    [(nth path step)]
                                    []))
                    :flash [(:pos event)]
                    [])]
        (recur (rest events) (core/into dirty cells))))))

(defn dirty-cell-entities
  "Return {pos -> entity} for entities on dirty cells. When multiple
   entities share a cell, the highest entity-z-priority wins
   (nooga/xsofy#30)."
  [entities dirty]
  (core/reduce (fn [m [_ e]]
                 (if (and (:pos e) (contains? dirty (:pos e)))
                   (let [pos (:pos e)
                         prev (get m pos)]
                     (if (or (nil? prev)
                             (< (entity-z-priority prev)
                                (entity-z-priority e)))
                       (assoc m pos e)
                       m))
                   m))
               {} entities))

(defn restore-dirty-cells!
  "Redraw only the given cells (map tile + any entity on them)."
  [world r dirty]
  (let [pos-ent (dirty-cell-entities (:entities world) dirty)]
    (pen-reset!)   ; vfx overlays emit raw between restores; start clean (see sgr-pen)
    ;; render-vfx-frame painted these cells raw without touching the appearance
    ;; buffer, so the buffer still holds their base appearance. Invalidate them
    ;; or the diff would skip the restore and leave the overlay tint stuck.
    (swap! cell-appearance (fn [m] (reduce dissoc m dirty)))
    (doseq [[x y] dirty]
      ;; render-cell! clips through map-cell in camera coords. Don't add an
      ;; outer (< x (:w r)) guard — that'd skip cells outside [0,rw) but
      ;; inside [cx, cx+rw), which on a scrolled map is most of them.
      (render-cell! world r pos-ent x y))))

(defn render-vfx-frame [world r]
  "Render vfx as color overlays on existing tiles. Does not overwrite glyphs."
  (let [vfx (or (:vfx world) [])
        stains (or (:stains world) {})]
    (when (seq vfx)
      (doseq [event vfx]
        (let [decay (or (:decay event) 1)
              max-decay (or (:max-decay event) decay)
              intensity (/ (float decay) (float max-decay))]
          (case (:type event)
            :bolt
            (let [[x0 y0] (:from event)
                  [x1 y1] (:to event)
                  cells (u/line-cells x0 y0 x1 y1)
                  tint (or (:color event) [140 160 255])
                  white [255 255 255]
                  i2 (* intensity intensity)]
              (doseq [[x y] cells]
                (when-let [[col row] (map-cell r x y)]
                  (let [tile (terrain/tget (:terrain world) (:width world) x y)
                        style (style-tile tile)
                        fg (boost-color (boost-color (:fg style) tint intensity)
                                        white i2)
                        bg (boost-color (boost-color (:bg style) tint (* intensity 0.7))
                                        white (* i2 0.5))
                        ch (get terrain/tile-chars tile ".")]
                    (term/move-cursor col row)
                    (let [[fr fg_ fb] fg] (term/set-fg fr fg_ fb))
                    (let [[br bg_ bb] bg] (term/set-bg br bg_ bb))
                    (term/write ch)))))

            :projectile
            (let [path (or (:path event) [])
                  step (or (:step event) 0)
                  glyph (or (:glyph event) "-")
                  color (or (:color event) [200 180 120])]
              (when (< step (count path))
                (let [[x y] (nth path step)]
                  (when-let [[col row] (map-cell r x y)]
                    (let [tile (terrain/tget (:terrain world) (:width world) x y)
                          style (style-tile tile)
                          bg-lit (let [lv (light-of world x y)]
                                   (if lv (light/apply-light (:bg style) lv) (:bg style)))]
                      (term/move-cursor col row)
                      (let [[fr fg_ fb] color] (term/set-fg fr fg_ fb))
                      (let [[br bg_ bb] bg-lit] (term/set-bg br bg_ bb))
                      (term/write glyph))))))

            :flash
            (let [[x y] (:pos event)
                  i2 (* intensity intensity)
                  tint (or (:color event) [255 255 255])
                  ent-at-pos (core/some (fn [[_ e]] (when (= (:pos e) [x y]) e))
                                        (:entities world))]
              (when-let [[col row] (map-cell r x y)]
                (let [tile (terrain/tget (:terrain world) (:width world) x y)
                      style (style-tile tile)
                      bg-lit (let [lv (light-of world x y)]
                               (if lv (light/apply-light (:bg style) lv) (:bg style)))
                      base-fg (if ent-at-pos
                                (get-in ent-at-pos [:visual :color] [200 60 60])
                                (:fg style))
                      fg (boost-color base-fg tint i2)
                      ch (if ent-at-pos
                           (get-in ent-at-pos [:visual :glyph] "?")
                           (get terrain/tile-chars tile "."))]
                  (term/move-cursor col row)
                  (let [[fr fg_ fb] fg] (term/set-fg fr fg_ fb))
                  (let [[br bg_ bb] bg-lit] (term/set-bg br bg_ bb))
                  (term/write ch))))

            nil)))
      ;; no flush here — the caller (animate-vfx!) presents the whole frame
      )))

(defn tick-vfx [vfx]
  "Advance vfx list — decay bolts/flashes, step projectiles. Remove expired."
  (vec (filter some?
        (mapv (fn [event]
               (if (= (:type event) :projectile)
                 ;; projectile: advance step, expire at end of path
                 (let [next-step (inc (or (:step event) 0))]
                   (when (< next-step (count (or (:path event) [])))
                     (assoc event :step next-step)))
                 ;; bolt/flash: decay
                 (let [d (dec (or (:decay event) 1))]
                   (when (> d 0)
                     (assoc event :decay d
                            :max-decay (or (:max-decay event)
                                           (or (:decay event) 1)))))))
             vfx))))

(defn vfx-frame-delay [vfx]
  "Projectile-only frames are faster, bolt/flash frames are slower."
  (if (every? #(= :projectile (:type %)) vfx) 25 50))

(defn animate-vfx! [world r]
  "Run vfx animation loop — only redraws affected cells between frames.
   Attaches the camera offset to the rect so vfx painted at world coords
   land in the right terminal cells even when the map is scrolled."
  (let [r (with-camera world r)]
    (loop [vfx (or (:vfx world) []) prev-dirty #{}]
      (when (seq vfx)
        ;; collect cells this frame will touch
        (let [cur-dirty (vfx-dirty-cells vfx)
              ;; restore cells from previous frame that aren't in current frame
              to-restore (core/into prev-dirty cur-dirty)]
          ;; restore all previously dirty cells first, then paint this frame's
          ;; overlay — all inside one synced frame
          (sfx/with-frame
            (when (seq prev-dirty)
              (restore-dirty-cells! world r prev-dirty))
            ;; render current vfx overlay
            (render-vfx-frame (assoc world :vfx vfx) r))
          (sfx/pause! (vfx-frame-delay vfx))
          (let [next-vfx (tick-vfx vfx)]
            (if (seq next-vfx)
              (recur next-vfx cur-dirty)
              ;; final frame — restore all dirty cells in one more synced pass
              (sfx/with-frame
                (restore-dirty-cells! world r cur-dirty)))))))))

;; --- Item Display Helpers ---

(defn item-display-name [world item-id]
  (let [item (get-in world [:entities item-id])]
    (if item
      (let [iname (or (:item-name item)
                      (name (or (:template item) (:id item))))
            enchant (get-in item [:item :enchant] 0)
            cnt (or (get-in item [:item :count]) 1)
            prefix (cond
                     (> enchant 0) (str "+" enchant " ")
                     (< enchant 0) (str enchant " ")
                     :else "")
            suffix (if (> cnt 1) (str " (" cnt ")") "")]
        (str prefix iname suffix))
      "???")))

(defn item-stat-str [world item-id]
  (let [item (get-in world [:entities item-id])
        slot (get-in item [:item :slot])]
    (case slot
      :weapon (let [lo (get-in item [:item :min-dmg] 0)
                    hi (get-in item [:item :max-dmg] 0)
                    spd (get-in item [:item :speed] 100)
                    sr (get-in item [:item :str-req] 1)
                    spd-tag (cond (< spd 80) "fast" (> spd 150) "slow" :else "")]
                (str lo "-" hi " dmg"
                     (when (not= spd-tag "") (str " " spd-tag))
                     " str:" sr))
      :armor (let [def_ (get-in item [:item :defense] 0)
                   sr (get-in item [:item :str-req] 1)]
               (str def_ " def str:" sr))
      nil)))

;; --- Status Panel ---

(defn render-status [world r]
  (ui/write-line r 0 (str " yuhjklbn/1-9:move  .:wait  5/Z:rest  eUda:item  i:inv  <>:stairs  m:log  "
                          (input/action-key-labels :help) ":help  esc:"
                          (if *in-wasm* "restart" "quit"))
                 [60 60 60] ui/bg))

;; --- Quick Menu Overlay ---

(defn menu-title [action]
  (case action
    :equip "Equip what?"
    :unequip "Remove what?"
    :drop "Drop what?"
    :use "Use what?"
    :enchant "Enchant what?"
    "Select item:"))

(defn menu-filter [world action]
  "Returns vec of [inv-index item-id] pairs matching the action."
  (let [inv (or (get-in world [:entities :player :inventory]) [])
        equipment (or (get-in world [:entities :player :equipment]) {})]
    (vec (filter some?
      (map-indexed
        (fn [i item-id]
          (let [item (get-in world [:entities item-id])
                slot (get-in item [:item :slot])
                equipped (some (fn [[s id]] (= id item-id)) equipment)]
            (cond
              (= action :equip)
              (when (and slot (not= slot :consumable) (not equipped)) [i item-id])

              (= action :unequip)
              (when (and slot equipped) [i item-id])

              (= action :drop)
              [i item-id]

              (= action :use)
              (when (= slot :consumable) [i item-id])

              (= action :enchant)
              (when (or (= slot :weapon) (= slot :armor)) [i item-id])

              :else nil)))
        inv)))))

;; Where the open panel was last drawn, so closing it redraws only that.
(def ^:private open-panel-rect (atom nil))

;; Panels over the game share one background, a shade off the map's.
(def ^:private panel-bg [20 18 16])

(defn render-quick-menu [world]
  (sfx/with-frame
  (let [[tw th] (term-dims)
        action (or (:menu-action world) :equip)
        items (menu-filter world action)
        sel (or (:menu-sel world) -1)
        letters "abcdefghijklmnopqrstuvwxyz"
        menu-h (+ (max 1 (count items)) 4 ui/panel-pad-rows)
        long-hint " [letter] choose  [any other key] cancel"
        ;; a phone is narrower than the long hint; a box wider than the
        ;; terminal wraps its lines and scrolls the whole screen
        hint (cond (empty? items) " [any key] close"
                   (<= (+ 3 (count long-hint)) (- tw 2)) long-hint
                   :else " [a-z] pick  [esc] cancel")
        menu-w (max 36 (+ 3 (count hint)))
        r (ui/centered-rect tw th menu-w menu-h)
        _ (reset! open-panel-rect r)
        inner (ui/pad-rows (ui/box r (menu-title action) [220 200 160] [20 18 16]))]
    (if (empty? items)
      (ui/write-line inner 0 " Nothing available." [80 80 80] [20 18 16])
      (dotimes [i (count items)]
        (let [[inv-idx item-id] (nth items i)
              item (get-in world [:entities item-id])
              iname (item-display-name world item-id)
              glyph (or (get-in item [:visual :color]) [200 200 200])
              gch (or (get-in item [:visual :glyph]) "?")
              letter (if (< inv-idx 26) (str (nth letters inv-idx)) "?")
              selected (= i sel)
              fg (if selected [255 255 220] (or (get-in item [:visual :color]) [200 200 200]))
              bg (if selected [40 38 30] [20 18 16])
              stats (item-stat-str world item-id)
              stats-txt (if stats (str " [" stats "]") "")]
          (ui/write-line inner i
                         (str " " letter ") " gch " " iname stats-txt)
                         fg bg))))
    (ui/write-line inner (dec (:h inner)) hint [80 80 80] [20 18 16]))))

;; --- Message Log Screen (modal) ---

(defn render-messages-screen [world]
  (sfx/with-frame
  (let [[tw th] (term-dims)
        r (ui/centered-rect tw th messages-panel-w (messages-panel-h th))
        _ (reset! open-panel-rect r)
        ;; the border only, then every inside row written once below: blanking
        ;; the whole panel before each scroll step made it flicker
        frame (ui/box-frame r "Message Log" [180 170 140] panel-bg)
        _ (ui/write-line frame 0 "" [80 80 80] panel-bg)
        _ (ui/write-line frame (dec (:h frame)) "" [80 80 80] panel-bg)
        inner (ui/pad-rows frame)
        visible-lines (message-visible-lines th)
        window (message-log-window (:log world) visible-lines (:message-scroll world)
                                   (message-text-w tw))
        lines (:lines window)
        cnt (count lines)
        newest (dec (:end window))]
    (if (= cnt 0)
      (ui/write-line inner 0 " No messages yet." [90 90 90] panel-bg)
      (dotimes [i cnt]
        (let [{:keys [text entry]} (nth lines i)
              age (- newest entry)
              brightness (max 60 (- 220 (* age 6)))]
          (write-message-line! inner i (str " " text)
                               [brightness
                                (max 60 (- brightness 20))
                                (max 40 (- brightness 80))]
                               panel-bg))))
    ;; the rows between the text and the footer
    (doseq [y (range (max 1 cnt) (dec (:h inner)))]
      (ui/write-line inner y "" [80 80 80] panel-bg))
    (let [pos (if (> (:count window) 0)
                (str (inc (:start window)) "-" (:end window) "/" (:count window))
                "0/0")
          ;; widest first: a narrow panel keeps the hints that matter rather
          ;; than showing a cut-off row
          options [(str " " pos "  [j/k] scroll  [PgUp/PgDn] page  [g/G] ends  [esc] close")
                   (str " " pos "  [j/k] scroll  [esc] close")
                   " [j/k] scroll  [esc] close"]]
      (ui/write-line inner (dec (:h inner))
                     (or (first (filter #(<= (count %) (:w inner)) options)) (last options))
                     [80 80 80] panel-bg)))))

;; --- Help Screen (modal) ---

(def help-categories
  [[:movement "Movement"]
   [:actions "Actions"]
   [:items "Items"]
   [:information "Information"]
   [:system "System"]])

(defn- help-sections
  "[[title bindings] ...] for categories, in help-categories order."
  [categories]
  (mapv (fn [[category title]]
          [title (filterv #(= category (:category %)) input/key-bindings)])
        categories))

(defn- help-column-size
  "{:key-w :w :h} for a column of sections: keys and labels each as wide as
   their widest entry, so the columns sit tight instead of on a fixed grid."
  [sections]
  (let [bs (mapcat second sections)
        key-w (apply max 1 (map #(count (input/binding-key-labels %)) bs))
        label-w (apply max 1 (map #(count (:label %)) bs))]
    ;; heading at x 1; entries indented one more, then keys, a 2-space gap, label
    {:key-w key-w
     :w (+ 2 key-w 2 label-w)
     ;; a heading row per section, its entries, a blank line between sections
     :h (+ (count bs) (* 2 (count sections)) -1)}))

(defn help-layout
  "{:w :h :columns} for the help panel on a tw x th terminal: two columns
   (movement and actions | items, information, system) when they fit side by
   side, otherwise one."
  [tw th]
  (let [two [(help-sections (subvec help-categories 0 2))
             (help-sections (subvec help-categories 2))]
        one [(help-sections help-categories)]
        size (fn [cols]
               (let [ss (map help-column-size cols)]
                 ;; border 2, a column each plus 2 between, 1 spare on the right
                 {:w (+ 2 (reduce + (map :w ss)) (* 2 (dec (count ss))) 1)
                  ;; border 2, padding 2, tallest column, gap + footer
                  :h (+ 2 ui/panel-pad-rows (apply max (map :h ss)) 2)}))
        s2 (size two)
        [cols sz] (if (<= (:w s2) (- tw 2)) [two s2] [one (size one)])]
    {:w (:w sz) :h (min (:h sz) (- th 2)) :columns cols}))

(defn- render-help-column! [inner x0 sections]
  (let [{:keys [key-w]} (help-column-size sections)]
    (loop [ss sections y 0]
      (when-let [[title bs] (first ss)]
        (ui/write-at inner (+ x0 1) y title [220 200 160] panel-bg)
        (dotimes [i (count bs)]
          (let [b (nth bs i) yy (+ y 1 i)]
            (ui/write-at inner (+ x0 2) yy (input/binding-key-labels b) [180 170 130] panel-bg)
            (ui/write-at inner (+ x0 2 key-w 2) yy (:label b) [170 170 170] panel-bg)))
        (recur (rest ss) (+ y 2 (count bs)))))))

(defn render-help-screen [world]
  (sfx/with-frame
  (let [[tw th] (term-dims)
        {:keys [w h columns]} (help-layout tw th)
        r (ui/centered-rect tw th w h)
        _ (reset! open-panel-rect r)
        inner (ui/pad-rows (ui/box r "Keybindings" [180 170 140] panel-bg))]
    (loop [cs columns x0 0]
      (when-let [c (first cs)]
        (render-help-column! inner x0 c)
        (recur (rest cs) (+ x0 (:w (help-column-size c)) 2))))
    (ui/write-line inner (dec (:h inner)) " [esc] close" [80 80 80] panel-bg))))

;; --- Inventory Screen (modal) ---

(defn is-equipped? [world item-id]
  (let [equip (or (get-in world [:entities :player :equipment]) {})]
    (some (fn [[s id]] (= id item-id)) equip)))

;; The inventory and inscribe screens share one panel, so moving between them
;; (s on an item, then esc or enter) doesn't make the box jump.
(def ^:private inventory-panel-w 76)
(def ^:private inventory-list-w 32)

(defn inventory-panel-rect
  "The inventory panel, centred: a fixed width, and rows for the equipment
   header, the backpack and the hint, with room for an item's details."
  [world tw th]
  (let [n (count (or (get-in world [:entities :player :inventory]) []))]
    (ui/centered-rect tw th inventory-panel-w (+ 2 ui/panel-pad-rows (max 16 (+ 10 n))))))

(defn render-item-detail
  "Render item description and available commands starting at row y."
  [r y world item-id]
  (let [item (get-in world [:entities item-id])]
    (when item
      (let [slot (get-in item [:item :slot])
            equipped (is-equipped? world item-id)
            row (atom y)
            ;; every line wraps rather than running off the panel's edge,
            ;; which on a narrow (phone) terminal cut off the key hints
            put! (fn [text fg]
                   (ui/write-line r @row (str " " text) fg panel-bg)
                   (swap! row inc))
            line! (fn [text fg]
                    (doseq [l (ui/wrap-text text (- (:w r) 1))] (put! l fg)))]
        (line! (or (:item-desc item) "No description.") [160 150 130])
        (swap! row inc)
        (when-let [stats (item-stat-str world item-id)]
          (line! (str " Stats: " stats) [140 130 110]))
        ;; comparison with equipped
        (when (and (= slot :weapon) (not equipped))
          (let [cur-wep (ent/get-weapon world :player)
                cur-dmg (if cur-wep
                          (str (get-in cur-wep [:item :min-dmg] 0) "-"
                               (get-in cur-wep [:item :max-dmg] 0))
                          "1-2")
                new-dmg (str (get-in item [:item :min-dmg] 0) "-"
                             (get-in item [:item :max-dmg] 0))]
            (line! (str " Current: " cur-dmg " -> " new-dmg) [100 100 120])))
        (when (and (= slot :armor) (not equipped))
          (let [cur-arm (ent/get-armor world :player)
                cur-def (if cur-arm (or (get-in cur-arm [:item :defense]) 0) 0)
                new-def (or (get-in item [:item :defense]) 0)]
            (line! (str " Current: " cur-def " -> " new-def " def") [100 100 120])))
        ;; rune inscriptions
        (let [item-runes (:runes item)
              rune-table (or (:rune-table world) {})]
          (when (seq item-runes)
            (line! (str " Glyphs: " (runes/format-glyphs rune-table item-runes)) [120 100 200])
            (line! (str " Spell:  " (runes/format-sexp rune-table item-runes)) [160 140 200])))
        ;; available commands
        (swap! row inc)
        (doseq [l (ui/wrap-chips
                    (cond
                      (= slot :consumable) ["[a] use" "[d] drop"]
                      equipped             ["[U] unequip" "[s] inscribe" "[d] drop"]
                      (and slot (not= slot :consumable)) ["[e] equip" "[s] inscribe" "[d] drop"]
                      :else                ["[d] drop"])
                    (- (:w r) 1))]
          (put! l [120 120 100]))))))

(defn render-inventory-screen [world]
  (sfx/with-frame
  (let [[tw th] (term-dims)
        r (inventory-panel-rect world tw th)
        _ (reset! open-panel-rect r)
        inner (ui/pad-rows (ui/box r "Inventory" [180 170 140] panel-bg))
        inv (or (get-in world [:entities :player :inventory]) [])
        equipment (or (get-in world [:entities :player :equipment]) {})
        sel (or (:inv-sel world) -1)
        letters "abcdefghijklmnopqrstuvwxyz"
        ;; the key hint wraps on a narrow panel, so it can take more than one row
        foot (ui/wrap-chips ["[a-z/jk] select" "[esc/i] close"] (- (:w inner) 1))
        ;; list on the left, details on the right, a gutter between
        [list-r rest-r] (ui/rect-split-h inner (min inventory-list-w (quot (:w inner) 2)))
        detail-r (ui/rect (+ (:x rest-r) 2) (:y rest-r) (max 1 (- (:w rest-r) 2)) (max 1 (- (:h rest-r) (count foot))))]
    ;; equipment header
    (ui/write-line list-r 0 " Equipment:" [220 200 160] panel-bg)
    (doseq [[row label id] [[1 "W" (:weapon equipment)]
                            [2 "A" (:armor equipment)]
                            [3 "R" (:ring equipment)]]]
      (ui/write-line list-r row
                     (str "  " label ": " (if id (item-display-name world id) "-"))
                     (if id [180 180 210] [60 60 60]) panel-bg))
    ;; gold
    (ui/write-line list-r 4 (str "  $ " (or (:gold world) 0)) [255 220 50] panel-bg)
    ;; backpack
    (ui/write-line list-r 6 " Backpack:" [220 200 160] panel-bg)
    (if (empty? inv)
      (ui/write-line list-r 7 "  (empty)" [60 60 60] panel-bg)
      (dotimes [i (min (count inv) (- (:h list-r) 8 (count foot)))]
        (let [item-id (nth inv i nil)]
          (when item-id
            (let [item (get-in world [:entities item-id])
                  iname (item-display-name world item-id)
                  equipped (is-equipped? world item-id)
                  color (or (get-in item [:visual :color]) [200 200 200])
                  glyph (or (get-in item [:visual :glyph]) "?")
                  letter (if (< i 26) (str (nth letters i)) "?")
                  mark (if equipped "*" " ")
                  selected (= i sel)
                  fg (if selected [255 255 220] color)
                  bg (if selected [48 44 34] panel-bg)]
              (ui/write-line list-r (+ 7 i)
                             ;; the equipped mark sits a column in from the border
                             (str " " mark letter ") " glyph " " iname)
                             fg bg))))))
    ;; detail panel
    (if (and (>= sel 0) (< sel (count inv)))
      (do (ui/write-line detail-r 0 (item-display-name world (nth inv sel))
                         (or (get-in world [:entities (nth inv sel) :visual :color]) [220 200 160])
                         panel-bg)
          (render-item-detail detail-r 2 world (nth inv sel)))
      (ui/write-line detail-r 0 "Select an item (a-z)" [80 80 80] panel-bg))
    ;; controls at bottom
    (doseq [[i l] (map-indexed vector foot)]
      (ui/write-line inner (+ (- (:h inner) (count foot)) i) (str " " l)
                     [80 80 80] panel-bg)))))

;; --- Death Screen ---

(declare codex-entries)

;; A scene drawn once (on entry and on a resize), then only the background
;; runes each tick. Redrawing the whole screen every tick to pulse a few glyphs
;; was most of its output and showed as flicker. Design and mocks:
;; project-docs/docs/joint-xsofy/death-screen-mock/.

(def tombstone-epitaphs
  [["Here lies a"    "brave soul"]
   ["Rest in"        "pieces"]
   ["Gone but not"   "forgotten"]
   ["They died as"   "they lived"]
   ["Here rots the"  "erstwhile hero"]
   ["Farewell to"    "the reckless"]
   ["Alas, poor"     "soul most vexed"]
   ["So long and"    "thanks for"      "the fish"]
   ["No refunds"     "for the deceased"]])

;; One is carved under each epitaph, picked per run. ᛉ/ᛦ was tried and
;; dropped: it reads as one of the game's runes.
(def ^:private death-dividers
  ["───  ✝  ───" "·  ·  ✦  ·  ·" "◦ ──  ✧  ── ◦" "⌒⌒  ✝  ⌒⌒"])

(def ^:private stone-inner 21)
(def ^:private stone-face [26 23 19])
(def ^:private stone-side [21 19 16])
(def ^:private stone-edge [150 135 110])
(def ^:private grass-near [[45 85 32] [65 120 45] [90 150 60]])
(def ^:private grass-far [[28 50 22] [36 62 27]])
(def ^:private death-red [150 45 30])
;; share of the empty face cells that carry a weathering mark
(def ^:private speckle-rate 0.06)

;; Grave grass, from Matt's favourites in the grass spike (2026-11-27,
;; project-docs joint-xsofy/death-screen-mock/grass.html, favourites mode): a
;; clump on one corner seam of the stone, something lighter on the other side,
;; at most one tall thin stem (it carries the bud when there is one), the
;; middle of the stone low, the floor scatter wide. A base is three cells on
;; the stone's bottom row, and each glyph decides what grows above it.
(def ^:private grass-dominant ["\\|/" " |/" "\\| " " |," ".| " " !/" "\\! " " V "])
(def ^:private grass-light [" |," ".| " " !/" " |/" " V " "\\! "])
(def ^:private grass-bud [205 198 170])
(def ^:private grass-flip {"/" "\\" "\\" "/"})

(defn- mirror-base [base]
  (apply str (map #(get grass-flip % %) (reverse (map str base)))))

(defn- grass-symmetric?
  "Too regular: every mark has a partner across the clump's middle, the same
   glyph or its mirror. Light tip marks all count as one kind, since in the
   game font ' slants like a mirrored `."
  [m]
  (let [kind (fn [ch] (if (cstr/includes? "'`,.:;" ch) :tip ch))]
    (and (> (count m) 1)
         (let [xs (map ffirst m)
               span (+ (apply min xs) (apply max xs))]
           (every? (fn [[[x u] ch]]
                     (when-let [o (get m [(- span x) u])]
                       (let [a (kind ch) c (kind o)]
                         (or (= a c) (= c (get grass-flip a))))))
                   m)))))

(defn- grave-grass
  "The grass around the stone as {:far {[dx up] [ch fg]} :near {...}}. dx
   counts from the stone's left wall, up from its bottom row (0 is the bottom
   row itself, -1 the scatter under it). Drawn from rnd, so a run keeps its
   grass on a replay."
  [inner rnd]
  (let [ri (fn [n] (int (* (rnd) n)))
        pick (fn [xs] (nth xs (ri (count xs))))
        heavy (if (< (rnd) 0.5) -1 1)
        far (atom {})
        near (atom {})
        wrote (atom nil)
        spots (atom [])
        tall-left (atom 1)
        wall? (fn [dx] (contains? #{0 (inc inner) (+ inner 2)} dx))
        ;; the middle ~75% of the stone stays low; the corner columns keep
        ;; a tip on a clump tucked into the seam
        centre? (fn [dx] (<= 3 dx (- inner 2)))
        blade! (fn [dx up ch shade]
                 (when-not (and (> up 1) (centre? dx))
                   (swap! near assoc [dx up] [ch (nth grass-near shade)])
                   (when @wrote (swap! wrote assoc [dx up] ch))))
        tip (fn [] (pick ["'" "`" "'" ","]))
        grow! (fn [dx ch dom? light?]
                (let [h (cond (and (= ch "|") dom? (pos? @tall-left) (< (rnd) 0.75))
                              (do (reset! tall-left 0) (if (< (rnd) 0.5) 1 2))
                              (and (or (= ch "/") (= ch "\\")) (not light?) (< (rnd) 0.35)) 1
                              :else 0)]
                  (cond
                    (= ch "|")
                    (do (doseq [u (range 1 (inc h))] (blade! dx u "|" (if (= u h) 2 1)))
                        (when (< h 2) (blade! dx (inc h) (tip) 2))
                        ;; a bud only ever sits on a tall straight stem
                        (when (pos? h) (swap! spots conj [dx (inc h)])))
                    (or (= ch "/") (= ch "\\"))
                    (let [s (if (= ch "/") 1 -1)]
                      (doseq [u (range 1 (inc h))] (blade! (+ dx (* s u)) u ch 1))
                      (blade! (+ dx (* s (inc h))) (inc h) (tip) 2))
                    ;; one arm only: "\\ /" over "V" reads as a drawn shape
                    (= ch "V")
                    (let [s (if (< (rnd) 0.5) -1 1)
                          other [(- dx s) 1]]
                      (blade! (+ dx s) 1 (if (neg? s) "\\" "/") 1)
                      ;; a background tuft could supply the other arm by chance
                      (when (= (first (get @far other)) (if (neg? s) "/" "\\"))
                        (swap! far dissoc other))
                      (when (< (rnd) 0.5) (blade! (+ dx (* 2 s)) 2 (tip) 2))))))
        grow-once! (fn [centre base dom? light?]
                     (doseq [[i ch] (map-indexed vector (map str base))]
                       (let [x (+ centre (dec i))]
                         ;; a straight stem on the wall reads as part of it;
                         ;; leans and Vs may straddle the corner
                         (when (and (not= ch " ")
                                    (not (and (wall? x) (or (= ch "|") (= ch "!")) (< (rnd) 0.92)))
                                    (not (and light? (not= i 1) (< (rnd) 0.5))))
                           (blade! x 0 ch (if (or (= ch ",") (= ch ".")) 0 (if (< (rnd) 0.4) 2 1)))
                           (grow! x ch dom? light?)))))
        clump! (fn [centre base dom? light?]
                 (let [snap [@near @far @tall-left @spots]]
                   (loop [tries 1]
                     (reset! wrote {})
                     (grow-once! centre base dom? light?)
                     (when (and (grass-symmetric? @wrote) (< tries 6))
                       (let [[n f t sp] snap]
                         (reset! near n) (reset! far f) (reset! tall-left t) (reset! spots sp))
                       (recur (inc tries))))
                   (let [m @wrote]
                     (when (grass-symmetric? m)
                       ;; still regular after six tries: take the top mark off one side
                       (let [xs (map ffirst m)
                             mid (/ (+ (apply min xs) (apply max xs)) 2.0)
                             left? (< (rnd) 0.5)
                             side (filter (fn [[[x _] _]] (if left? (< x mid) (> x mid))) m)
                             [[x u] _] (or (last (sort-by (fn [[[_ u] _]] u) side)) (first m))]
                         (if-let [prev (get (first snap) [x u])]
                           (swap! near assoc [x u] prev)
                           (swap! near dissoc [x u])))))
                   (reset! wrote nil)))]
    ;; background tufts: a few on each side, tilted a little toward the heavy one
    (doseq [side [-1 1]]
      (let [tilt (if (= side heavy) 1.15 0.75)
            n1 (max 3 (int (+ 0.5 (* (+ 3 (ri 4)) tilt))))
            ds (vec (concat (vec (repeatedly n1 #(vector (+ 2 (ri 13)) 1)))
                            (vec (repeatedly (ri 3) #(vector (+ 3 (ri 9)) 2)))
                            (when (< (rnd) 0.5) [[(+ 4 (ri 6)) 3]])))]
        (doseq [[d up] ds]
          (swap! far assoc [(if (neg? side) (- d) (+ inner 1 d)) up]
                 [(pick ["," "'" "/" "\\" "|" "`"]) (nth grass-far (ri 2))]))))
    ;; the clumps: the heavy side's on the seam (just outside, straddling the
    ;; wall, or tucked into the face's corner), the light one a little way out
    (let [dom (pick grass-dominant)
          lite (loop [b (pick grass-light)] (if (= b dom) (recur (pick grass-light)) b))
          ;; on the right, the dominant base faces the stone more often than not
          dom (if (and (pos? heavy) (< (rnd) 0.6)) (mirror-base dom) dom)
          out-at (fn [side] (if (neg? side) (- (inc (ri 3))) (+ inner 3 (ri 3))))
          seam-at (fn [side] (pick (if (neg? side) [-1 1 2 2] [(+ inner 3) (inc inner) inner inner])))]
      (doseq [side [-1 1]]
        (let [dom? (= side heavy)]
          (if (and (not dom?) (< (rnd) 0.3))
            ;; sometimes the light side is just a mark or two at the foot of the wall
            (let [x (out-at side)]
              (blade! x 0 (pick ["," "'" "`" "." "v"]) 1)
              (when (< (rnd) 0.5) (blade! (+ x (if (< (rnd) 0.5) -1 1)) 0 (pick ["," "."]) 0)))
            (clump! (if dom? (seam-at side) (out-at side)) (if dom? dom lite) dom? (not dom?))))))
    ;; the heavy side's ground: low punctuation spreading out from its
    ;; corner along the bottom row, thinning as it goes
    (let [corner (if (neg? heavy) 0 (inc inner))
          reach (+ 5 (ri 7))]
      (doseq [d (range 2 (inc reach))]
        (when-not (> (rnd) (- 1 (/ d (+ reach 2.0))))
          (doseq [s [heavy (- heavy)]]
            ;; only a little way in over the stone's base
            (when-not (and (= s (- heavy)) (or (> d 4) (< (rnd) 0.5)))
              (let [x (+ corner (* s d))]
                (when-not (get @near [x 0])
                  (blade! x 0 (pick [":" ";" "," "." "+" "'" "`" "," "."]) (if (< (rnd) 0.3) 1 0))
                  (when (and (= s heavy) (< (rnd) 0.12))
                    (blade! x 1 (pick ["," "'" "`"]) 0)))))))))
    ;; at most one bud, pale, on the tall stem's tip and never on a wall
    (let [ok (vec (filter (fn [[x u]] (and (not (wall? x)) (not (and (> u 1) (centre? x))))) @spots))]
      (when (and (seq ok) (< (rnd) 0.35))
        (swap! near assoc (pick ok) ["*" grass-bud])))
    ;; singles along the stone's base, not side by side
    (loop [i 0 used #{} n (+ 3 (ri 3))]
      (when (< i n)
        (let [x (+ 4 (ri (- inner 7)))]
          (if (or (used x) (used (dec x)) (used (inc x)))
            (recur (inc i) used n)
            (do (blade! x 0 (pick ["," "^" "'" "." "`"]) (ri 2))
                (recur (inc i) (conj used x) n))))))
    ;; the scatter under it: densest at the stone's corners, thinning to the
    ;; middle and out to ten columns past each corner, no glyph twice running
    (let [weeds ["." "." ":" ";" "," "," "'" "\"" "`"]]
      (loop [x -10 prev nil]
        (when (<= x (+ inner 11))
          (let [nearc (min (math/abs x) (math/abs (- x (inc inner))))
                outside (cond (neg? x) (- x) (> x (inc inner)) (- x (inc inner)) :else 0)
                tilt (if (= (if (< (* 2 x) (inc inner)) -1 1) heavy) 1.15 0.75)
                p (min 0.95 (* tilt (if (pos? outside)
                                      (* 0.7 (- 1 (/ outside 11.0)))
                                      (cond (< nearc 3) 0.85 (< nearc 7) 0.55 :else 0.3))))]
            (if (> (rnd) p)
              (recur (inc x) nil)
              (let [c (loop [c (pick weeds)] (if (= c prev) (recur (pick weeds)) c))]
                (swap! near assoc [x -1] [c (first grass-near)])
                (recur (inc x) c)))))))
    {:far @far :near @near}))

(defn- run-pick
  "A number in [0, n) fixed for this run's death (seed, turn and what it is
   for), so a replay or a shared ?seed= draws the same stone."
  [world what n]
  (mod (math/abs (hash [(:seed-input world) (:turn world) what])) n))

(defn- run-rng
  "A deterministic stream of floats in [0, 1) for this run's death."
  [world what]
  (let [s (atom (mod (math/abs (hash [(:seed-input world) (:turn world) what])) 2147483647))]
    (fn []
      (swap! s (fn [v] (mod (+ (* v 1103515245) 12345) 2147483648)))
      (/ (double @s) 2147483648.0))))

(defn- log-text [entry]
  (if (map? entry) (:msg entry) (str entry)))

(defn death-cause
  "The panel title: who or what ended the run."
  [world]
  (let [lines (map log-text (take-last 6 (or (:log world) [])))
        named (some (fn [l] (second (re-find #"^The (.+?) (?:shoots and )?kills you!" l)))
                    (reverse lines))
        kid (:cause-of-death world)
        tpl (when (keyword? kid) (get-in world [:entities kid :template]))
        who (or named (when tpl (cstr/replace (name tpl) "-" " ")))
        recent (cstr/lower-case (cstr/join " " lines))]
    (cond
      who (str "slain by " (if (contains? #{"a" "e" "i" "o" "u"} (subs who 0 1)) "an " "a ") who)
      (cstr/includes? recent "lava") "taken by the lava"
      (or (cstr/includes? recent "burn") (cstr/includes? recent "fire")) "burned to death"
      (cstr/includes? recent "poison") "poisoned"
      (or (cstr/includes? recent "drown") (cstr/includes? recent "water")) "drowned"
      :else "the end")))

(defn- learned-runes [world]
  (->> (codex-entries (:rune-table world))
       (filter :known?)
       (map :glyph)
       (take 10)
       (cstr/join " ")))

(defn- death-prompt [tw]
  ;; on the web esc offered "restart", which only asked to confirm what [n]
  ;; does; there is nothing to quit to, so the web prompt leaves esc out
  (first (filter #(<= (count %) (- tw 2))
                 (if *in-wasm*
                   ["[n] new game    [m] messages"
                    "[n] new  [m] log"
                    "[n] new"]
                   ["[n] new game    [m] messages    [esc] quit"
                    "[n] new  [m] log  [esc] quit"
                    "[n] new  [m] log  [esc]"
                    "[n] new"]))))

(defn- death-stats [world tw]
  (let [d (or (:depth world) 1) t (or (:turn world) 0) g (or (:gold world) 0)]
    (first (filter #(<= (count %) (- tw 2))
                   [(str "Depth " d "  ·  Turn " t "  ·  Gold " g)
                    (str "Depth " d " · Turn " t " · Gold " g)
                    (str "D" d " · T" t " · " g "g")]))))

(defn death-scene
  "The death screen as data: {:cells {[x y] [glyph fg bg]} :keep-out [[x0 y0
   x1 y1] ...]}, 0-based, clipped to tw x th. :keep-out is where the
   background runes may not land: the text, the stone and its grass, the panel."
  [world tw th]
  (let [cells (atom {})
        boxes (atom [])
        bg ui/bg
        put! (fn [x y text fg cbg]
               (let [text (str text)]
                 (dotimes [i (count text)]
                   (let [xx (+ x i)]
                     (when (and (< -1 xx tw) (< -1 y th))
                       (swap! cells assoc [xx y] [(subs text i (inc i)) fg cbg]))))))
        center! (fn [y text fg]
                  (let [x (- (quot tw 2) (quot (count text) 2))]
                    (put! x y text fg bg)
                    (swap! boxes conj [(dec x) y (+ x (count text)) y])))
        cx (quot tw 2)
        inner stone-inner
        epitaph (nth tombstone-epitaphs (rem (or (:turn world) 0) (count tombstone-epitaphs)))
        divider (nth death-dividers (run-pick world :divider (count death-dividers)))
        runes-txt (learned-runes world)
        title (or (:title world) "")
        stats (death-stats world tw)
        prompt (death-prompt tw)
        panel-w (min 46 (- tw 2))
        ;; the stone's face, top to bottom; :compact drops the blank rows
        body-full (vec (concat ["" "R . I . P" ""] epitaph ["" divider runes-txt]))
        body-compact (vec (concat ["R . I . P"] epitaph [divider] (when (seq runes-txt) [runes-txt])))
        ;; rows above the panel's lines: title, seed, gap, crown, shoulder,
        ;; body, bottom, weeds, gap, stats, gap, panel border; below: border,
        ;; gap, prompt
        fixed (fn [body] (+ 2 1 2 (count body) 1 1 1 1 1 1 1 1 1))
        [body lines] (let [room-full (- th (fixed body-full))
                           room-compact (- th (fixed body-compact))]
                       (cond (>= room-full 3) [body-full (min 6 room-full)]
                             :else [body-compact (max 1 (min 6 room-compact))]))
        total (+ (fixed body) lines)
        ;; centred, then a row lower where there is room for it (Matt: the
        ;; column sat a touch high)
        y0 (max 0 (min (- th total) (inc (quot (- th total) 2))))
        sx (- cx (quot (+ inner 2) 2))
        crown-y (+ y0 3)
        bot (+ crown-y 2 (count body))
        rnd (run-rng world :speckle)
        grass (grave-grass inner (run-rng world :grass))]
    ;; title and seed
    (when (seq title) (center! y0 title [230 200 100]))
    (center! (inc y0) (str "seed " (:seed-input world)) [110 105 90])
    ;; background grass first, so the stone covers what is behind it
    (doseq [[[dx up] [ch fg]] (:far grass)]
      (put! (+ sx dx) (- bot up) ch fg bg))
    ;; the stone: a _ crown resting on the face, slanted shoulders, sides, a
    ;; side strip for thickness
    ;; the edge runs out to meet the shoulders: " ___ " over "/   \"
    (put! (+ sx 2) crown-y (apply str (repeat (- inner 2) "_")) stone-edge bg)
    (put! (+ sx 1) (inc crown-y) "╱" stone-edge bg)
    (put! (+ sx 2) (inc crown-y) (apply str (repeat (- inner 2) " ")) stone-edge stone-face)
    (put! (+ sx inner) (inc crown-y) "╲" stone-edge bg)
    (put! (+ sx inner 1) (inc crown-y) " " stone-edge stone-side)
    (dotimes [r (count body)]
      (let [y (+ crown-y 2 r)
            b (- 135 (* r 4))]
        (put! sx y "│" [b (- b 15) (- b 40)] bg)
        (put! (inc sx) y (apply str (repeat inner " ")) stone-edge stone-face)
        (put! (+ sx inner 1) y "│" [(- b 20) (- b 35) (- b 55)] bg)
        (put! (+ sx inner 2) y " " stone-edge stone-side)
        (let [t (nth body r)]
          (when (seq t)
            (put! (+ sx 1 (quot (- inner (count t)) 2)) y t
                  (cond (= t "R . I . P") [160 140 110]
                        (= t divider) [120 102 80]
                        (= t runes-txt) [150 130 100]
                        :else [120 105 85])
                  stone-face)))))
    (put! sx bot (str "╰" (apply str (repeat inner "─")) "╯") [100 85 65] bg)
    (put! (+ sx inner 2) bot " " stone-edge stone-side)
    ;; weathering: faint marks on empty face cells, never beside a letter,
    ;; where one would read as punctuation
    (let [face? (fn [x y] (let [c (get @cells [x y])]
                            (and c (= " " (first c)) (= stone-face (nth c 2)))))
          letter? (fn [x y] (let [c (get @cells [x y])]
                              (and c (not= " " (first c)) (= stone-face (nth c 2)))))]
      (doseq [y (range (+ crown-y 2) bot) x (range (inc sx) (+ sx inner 1))]
        (when (and (face? x y) (not (letter? (dec x) y)) (not (letter? (inc x) y))
                   (< (rnd) speckle-rate))
          (let [v (+ 40 (int (* 18 (rnd))))]
            (put! x y (nth ["." "·" "," "`" "'" "·" "."] (int (* 7 (rnd))))
                  [v (- v 4) (- v 10)] stone-face)))))
    ;; grass in front, over the stone's face where it climbs onto it
    (doseq [[[dx up] [ch fg]] (:near grass)]
      (let [x (+ sx dx) y (- bot up)
            under (get @cells [x y])
            cbg (if (and under (pos? up)) (nth under 2) bg)]
        (put! x y ch fg cbg)))
    ;; stats
    (center! (+ bot 3) stats [140 120 90])
    ;; last moments, under a red frame titled with the cause
    (let [py (+ bot 5)
          px (- cx (quot panel-w 2))
          cause (death-cause world)
          all (log-lines (vec (or (:log world) [])) (- panel-w 4))
          newest (:entry (peek all))
          ;; whole messages from the newest back, as many as fit; a killing
          ;; blow that alone wraps past the panel shows from its start
          firsts (loop [e newest]
                   (let [n (count (filter #(>= (:entry %) e) all))]
                     (cond (and newest (> n lines) (= e newest)) e
                           (> n lines) (inc e)
                           (or (nil? e) (zero? e)) e
                           :else (recur (dec e)))))
          ls (vec (take lines (filter #(>= (:entry %) (or firsts 0)) all)))
          hdr (str "╭─ " cause " ")]
      (put! px py (str hdr (apply str (repeat (max 0 (- panel-w (count hdr) 1)) "─")) "╮") death-red bg)
      (put! (+ px 3) py cause [225 85 55] bg)
      (dotimes [i lines]
        (let [y (+ py 1 i)]
          (put! px y "│" death-red bg)
          (put! (+ px panel-w -1) y "│" death-red bg)
          (when-let [{:keys [text entry]} (get ls i)]
            (put! (+ px 2) y text
                  (if (= entry newest) [230 210 170]
                      (let [b (max 110 (- 190 (* 12 (- newest entry))))] [b (- b 20) (- b 60)]))
                  bg))))
      (put! px (+ py lines 1) (str "╰" (apply str (repeat (- panel-w 2) "─")) "╯") death-red bg)
      ;; the runes keep out of one clear column, title to panel, as wide as
      ;; the stone with its grass or the panel, whichever is wider
      (let [half (max (quot panel-w 2) (+ (quot inner 2) 17))]
        (swap! boxes conj [(- cx half 1) (dec y0) (+ cx half 1) (+ py lines 2)])))
    ;; prompt on the last row
    (center! (dec th) prompt [80 70 60])
    {:cells @cells :keep-out @boxes}))

(defn death-runes
  "Scatter the background runes once per scene: crimson, centre-biased, and
   kept out of the scene's text, stone and panel. They stay fixed; each tick
   only pulses their brightness."
  [world tw th]
  (let [keep-out (:keep-out (death-scene world tw th))
        blocked? (fn [x y] (some (fn [[x0 y0 x1 y1]] (and (<= x0 x x1) (<= y0 y y1))) keep-out))
        ;; fewer on a small screen, where little room is left outside the scene
        n (min 30 (quot (* tw th) 90))]
    (loop [out [] tries 0]
      (if (or (>= (count out) n) (> tries (* 40 n)))
        out
        (let [x (quot (+ (rand-int tw) (rand-int tw)) 2)
              y (quot (+ (rand-int th) (rand-int th)) 2)
              v (- (rand-int 60) 30)]
          (if (or (blocked? x y) (some #(and (= (:x %) (inc x)) (= (:y %) (inc y))) out))
            (recur out (inc tries))
            (recur (conj out {:x (inc x) :y (inc y)
                              :glyph (nth sfx/rune-glyphs (rand-int (count sfx/rune-glyphs)))
                              :color [(max 30 (min 255 (+ 200 v)))
                                      (max 30 (min 255 (+ 50 v)))
                                      (max 30 (min 255 (+ 30 v)))]
                              :phase (rand-int 60)})
                   (inc tries))))))))

;; What render-death-screen last drew in full: the size and the world. Cleared
;; when something else drew over it (the message log), so the next frame
;; redraws the scene.
(def ^:private death-drawn (atom nil))

(defn reset-death-screen! [] (reset! death-drawn nil))

(defn- draw-scene! [{:keys [cells]} tw th]
  (ui/apply-bg ui/bg)
  (ui/apply-fg ui/bg)
  (dotimes [y th]
    (term/move-cursor 1 (inc y))
    (term/write (apply str (repeat tw " "))))
  ;; row by row, a cursor move and colour change per run of like cells
  (doseq [y (range th)]
    (let [xs (sort (keep (fn [[[x yy] _]] (when (= yy y) x)) cells))]
      (loop [xs xs prev-x -2 pen nil]
        (when-let [x (first xs)]
          (let [[ch fg cbg] (get cells [x y])
                p [fg cbg]]
            (when (not= x (inc prev-x)) (term/move-cursor (inc x) (inc y)))
            (when (not= p pen)
              (let [[r g b] fg [br bgc bb] cbg]
                (term/set-fg r g b) (term/set-bg br bgc bb)))
            (term/write ch)
            (recur (rest xs) x p)))))))

(defn render-death-screen
  "Draw the death screen: the whole scene only when it isn't already up (a
   new death, a resize, or after the message log covered it), then the
   background runes at their brightness for `frame`."
  [world runes frame]
  (sfx/with-frame
    (let [[tw th] (term-dims)
          drawn @death-drawn]
      (when-not (and drawn (= (:size drawn) [tw th]) (identical? (:world drawn) world))
        (draw-scene! (death-scene world tw th) tw th)
        (reset! death-drawn {:size [tw th] :world world}))
      ;; no background behind a rune: a tinted cell showed as a dim box
      (term/set-bg 10 10 10)
      (doseq [r runes]
        (let [b (max 0.1 (sfx/rune-brightness (:phase r) frame))
              [cr cg cb] (:color r)]
          (term/move-cursor (:x r) (:y r))
          (term/set-fg (int (* cr b)) (int (* cg b)) (int (* cb b)))
          (term/write (:glyph r)))))))

;; --- Death fade ---
;; The way into the death screen: the dungeon holds a moment, darkness closes
;; in from the edges until only the player is lit, that light dies, a beat of
;; black, then the scene fades in from the stone outward. Matt picked these
;; timings in the fade mock (project-docs joint-xsofy/death-screen-mock/fade.html,
;; at 0.7x its base speed).
;; Matt's tuning, 2026-11-27: a quick flash on the @ as the blow lands, then
;; a shorter hold, linger and beat, and a quicker fade-in
(def death-fade-ms {:flash 220 :hold 150 :out 1850 :linger 600 :beat 300 :in 1400 :ramp 330})
;; when the @ turns white and back during :flash, ms from the death
(def ^:private death-flash-steps [[0 :white] [60 :base] [110 :white] [170 :base]])

(defn- toward-bg
  "Colour `c` faded by `k` (0 dark .. 1 full) toward the screen background."
  [c k]
  (mapv (fn [v b] (int (+ b (* (- v b) k)))) c ui/bg))

(defn- app->cell
  "A map cell's appearance [ch fr fg fb br bg bb] as [ch fg bg]."
  [[ch fr fg fb br bgg bb]]
  [ch [fr fg fb] [br bgg bb]])

(defn- fade-in-events
  "Writes that bring the scene in: each cell gets a start time by its
   distance from the stone, plus noise, then brightens in four steps."
  [{:keys [cells]} tw th t0 {:keys [in ramp]}]
  (let [face-ys (keep (fn [[[_ y] [_ _ bg]]] (when (= bg stone-face) y)) cells)
        my (if (seq face-ys)
             (/ (+ (apply min face-ys) (apply max face-ys)) 2.0)
             (* th 0.4))
        mx (/ tw 2.0)]
    (for [[[x y] [ch fg bg]] cells
          :let [dx (/ (- x mx) (/ tw 2.0))
                dy (/ (- y my) (/ th 2.0))
                d (min 1.0 (math/sqrt (+ (* dx dx 0.35) (* dy dy))))
                start (+ t0 (* in (+ (* d 0.75) (* (rand) 0.25))))]
          step [1 2 3 4]
          :let [k (/ step 4.0)]]
      [(+ start (* ramp k)) (inc x) (inc y) ch (toward-bg fg k) (toward-bg bg k)])))

(defn death-fade-plan
  "Every write the fade makes on a tw x th terminal, as [ms col row ch fg bg]
   sorted by time (terminal coordinates, 1-based), plus :total ms. Built once
   per death; render-death-fade! plays it back."
  [world tw th]
  (let [{:keys [flash out linger beat in ramp] :as ms} death-fade-ms
        ;; the dungeon holds still after the flash, then the dark closes in
        hold (+ flash (:hold ms))
        ;; the camera the game last drew with: with-camera on the dead world
        ;; would recompute it for a player who is no longer there
        r0 (:map (ui/layout tw th))
        mr (if-let [c @last-camera] (assoc r0 :cx (:cx c) :cy (:cy c)) (with-camera world r0))
        ;; the killed player is gone from the world; use where it was drawn
        seen @last-player-drawn
        player (get-in world [:entities :player])
        [pc pr] (or (when-let [[x y] (or (:pos player) (:pos seen))] (map-cell mr x y))
                    [(quot tw 2) (quot th 2)])
        ;; the map as drawn, by screen position, so the edge can dim it a
        ;; step before it goes dark; the sidebar and log just go dark
        drawn (into {} (keep (fn [[[x y] app]] (when-let [sc (map-cell mr x y)] [sc app])))
                    @cell-appearance)
        ;; distance runs to the game area's farthest corner, not the
        ;; terminal's: on a wide window the game sits in the middle, and
        ;; scaling to the whole terminal spent most of the fade on empty screen
        gw (min ui/game-width tw) gh (min ui/game-height th)
        gx0 (inc (quot (- tw gw) 2)) gy0 (inc (quot (- th gh) 2))
        max-d (apply max 1.0
                     (for [cx [gx0 (+ gx0 gw -1)] cy [gy0 (+ gy0 gh -1)]]
                       (math/sqrt (+ (* (- cx pc) (- cx pc) 0.25) (* (- cy pr) (- cy pr))))))
        dark [" " ui/bg ui/bg]
        out-events
        (for [col (range 1 (inc tw)) row (range 1 (inc th))
              :when (not (and (= col pc) (= row pr)))
              :let [d (/ (math/sqrt (+ (* (- col pc) (- col pc) 0.25) (* (- row pr) (- row pr)))) max-d)
                    ;; outer cells first; the noise roughens the closing edge
                    gone (+ (* 0.85 (- 1 (min 1.0 (* d 1.15)))) (* (rand) 0.12))
                    app (get drawn [col row])]
              e (cond-> [(into [(+ hold (* out gone)) col row] dark)]
                  app (conj (let [[ch fg bg] (app->cell app)]
                              [(+ hold (* out (max 0 (- gone 0.06)))) col row ch
                               (toward-bg fg 0.45) (toward-bg bg 0.45)])))]
          e)
        [pch pfg pbg] (or (some->> player (entity-appearance world mr) app->cell)
                          (some-> (:app seen) app->cell)
                          ["@" [255 220 80] ui/bg])
        flash-events
        (for [[t c] death-flash-steps]
          [t pc pr pch (if (= c :white) [255 255 255] pfg) pbg])
        linger-events
        (for [i (range 1 9)
              :let [k (- 1 (/ i 8.0))]]
          [(+ hold out (* linger (/ i 8.0))) pc pr (if (pos? k) pch " ")
           (toward-bg pfg k) (toward-bg pbg k)])
        t-in (+ hold out linger beat)
        in-events (fade-in-events (death-scene world tw th) tw th t-in ms)]
    {:events (vec (sort-by first (concat flash-events out-events linger-events in-events)))
     :total (+ t-in in ramp)
     :i (atom 0)}))

(defn render-death-fade!
  "Make every write in `plan` due by `elapsed` ms that isn't made yet."
  [plan elapsed]
  (let [events (:events plan)
        n (count events)]
    (sfx/with-frame
      (loop [i @(:i plan)]
        (if (and (< i n) (<= (first (nth events i)) elapsed))
          (let [[_ col row ch [r g b] [br bgc bb]] (nth events i)]
            (term/move-cursor col row)
            (term/set-fg r g b)
            (term/set-bg br bgc bb)
            (term/write ch)
            (recur (inc i)))
          (reset! (:i plan) i))))))

(defn death-fade-done? [plan elapsed]
  (and (>= @(:i plan) (count (:events plan))) (>= elapsed (:total plan))))

(defn mark-death-drawn!
  "The fade has left the whole scene up: tell render-death-screen not to
   draw it again."
  [world tw th]
  (reset! death-drawn {:size [tw th] :world world}))

;; --- Rune Codex Screen ---

(defn codex-entries
  "Every randomized rune as {:glyph :label :known?}, in glyph order. The order
   is fixed for the whole game, so identifying a rune lights its cell up in
   place instead of moving it between lists."
  [rune-table]
  (let [order (into {} (map-indexed (fn [i g] [g i]) runes/rune-glyphs))]
    (->> rune-table
         (map (fn [[k v]]
                {:glyph (:glyph v)
                 :known? (boolean (:identified v))
                 :label (if (:identified v) (name k) (:garbled v))}))
         (sort-by #(get order (:glyph %) 999))
         vec)))

(def ^:private codex-panel-w 76)
(def ^:private codex-label-w 9)   ; "ᚠ essence": glyph, space, the longest label (7)
(def ^:private codex-cell-w 11)   ; a label and the gap before the next one
;; fewer, taller columns read down more easily than a wide 6-across grid
(def ^:dynamic *codex-max-cols* 5)

(defn codex-layout
  "{:w :cols :h :mode} for n runes on a tw x th terminal: as many columns as
   fit, and rows to hold them all. A phone (the on-screen keyboard takes half
   the height) can't fit the roomy panel, so :compact drops the padding and
   gaps and puts the numerals on the count line, and :bare also drops the
   footer (the phone's keyboard has its own Esc), so the whole grid shows."
  [n tw th]
  (let [fit-w (max 20 (min codex-panel-w (- tw 2)))
        ;; inner width is w - 2 and cells start at x 1; the last column needs
        ;; only its label, not the gap after it
        cols (min *codex-max-cols*
                  (max 1 (inc (quot (- fit-w 3 codex-label-w) codex-cell-w))))
        ;; the panel shrinks to its columns, so a capped grid isn't left-heavy
        w (min fit-w (+ 3 codex-label-w (* (dec cols) codex-cell-w) 2))
        rows (quot (+ n cols -1) cols)
        room (- th 2)
        ;; border 2, padding 2, count + gap, grid, gap + numerals, gap + footer
        roomy (+ 2 ui/panel-pad-rows 2 rows 2 2)
        ;; border 2, count and numerals, grid, footer
        compact (+ 2 1 rows 1)
        bare (+ 2 1 rows)
        [mode h] (cond (<= roomy room)   [:roomy roomy]
                       (<= compact room) [:compact compact]
                       :else             [:bare (min bare room)])]
    {:w w :cols cols :h h :mode mode}))

(defn render-rune-codex [world]
  (sfx/with-frame
  (let [[tw th] (term-dims)
        entries (codex-entries (or (:rune-table world) {}))
        n (count entries)
        known (count (filter :known? entries))
        {:keys [w cols h mode]} (codex-layout n tw th)
        roomy? (= mode :roomy)
        rows (quot (+ n cols -1) cols)
        r (ui/centered-rect tw th w h)
        _ (reset! open-panel-rect r)
        box (ui/box r "Rune Codex" [170 140 220] panel-bg)
        inner (if roomy? (ui/pad-rows box) box)
        numerals (apply str (interpose " " (vals (into (sorted-map) runes/numeral-glyphs))))
        grid-y (if roomy? 2 1)]
    (ui/write-line inner 0 (if roomy?
                             (str " Known " known " of " n)
                             (str " Known " known " of " n "   " numerals))
                   [200 180 240] panel-bg)
    (dotimes [i n]
      (let [{:keys [glyph label known?]} (nth entries i)
            x (+ 1 (* (mod i cols) codex-cell-w))
            y (+ grid-y (quot i cols))]
        (ui/write-at inner x y glyph (if known? [210 190 255] [105 90 140]) panel-bg)
        (ui/write-at inner (+ x 2) y label (if known? [175 155 225] [85 75 105]) panel-bg)))
    (when roomy?
      (ui/write-line inner (+ grid-y rows 1) (str " " numerals "  numerals, always known")
                     [120 110 150] panel-bg))
    (when-not (= mode :bare)
      (ui/write-line inner (dec (:h inner)) " [esc] close" [80 80 80] panel-bg)))))

;; --- Inscription Screen ---

(defn render-inscribe-screen [world]
  (sfx/with-frame
  (let [[tw th] (term-dims)
        r (inventory-panel-rect world tw th)
        _ (reset! open-panel-rect r)
        inner (ui/pad-rows (ui/box r "Inscribe Runes" [200 160 240] panel-bg))
        rune-table (or (:rune-table world) {})
        item-id (:inscribe-item-id world)
        item (get-in world [:entities item-id])
        iname (or (:item-name item) (name (or (:template item) :unknown)))
        current-runes (or (:inscribe-runes world) [])
        available (runes/inscribable-runes rune-table)
        sel (or (:inscribe-sel world) 0)
        ;; layout: top = item info + current runes, bottom = rune picker
        [top-r bottom-r] (ui/rect-split-v inner (min 8 (quot (:h inner) 3)))]
    ;; item info
    (ui/write-line top-r 0 (str " Item: " iname) [220 200 160] panel-bg)
    ;; current inscription
    (if (seq current-runes)
      (do
        (ui/write-line top-r 2
                       (str " Glyphs: " (runes/format-glyphs rune-table current-runes))
                       [160 140 220] panel-bg)
        (ui/write-line top-r 3
                       (str " Spell:  " (runes/format-sexp rune-table current-runes))
                       [180 160 240] panel-bg))
      (ui/write-line top-r 2 " (no runes inscribed yet)" [80 80 80] panel-bg))
    ;; existing runes on item
    (when-let [old-runes (:runes item)]
      (when (seq old-runes)
        (ui/write-line top-r 5
                       (str " Current: " (runes/format-glyphs rune-table old-runes)
                            " " (runes/format-sexp rune-table old-runes))
                       [100 90 140] panel-bg)))
    ;; rune picker
    (ui/write-line bottom-r 0 " Available runes:" [200 180 240] panel-bg)
    (if (empty? available)
      (ui/write-line bottom-r 1 "  (no runes discovered yet)" [80 80 80] panel-bg)
      (let [cols 4
            col-w (quot (:w bottom-r) cols)
            max-rows (- (:h bottom-r) 3)]
        (dotimes [i (min (count available) (* cols max-rows))]
          (let [rn (nth available i)
                row (rem i max-rows)
                col (quot i max-rows)
                x (* col col-w)
                selected (= i sel)
                fg (if selected [255 255 220] [160 140 220])
                bg-c (if selected [40 30 60] panel-bg)]
            (ui/write-at bottom-r (+ x 1) (+ row 1)
                         (str (:glyph rn) " " (:name rn))
                         fg bg-c)))))
    ;; controls
    (ui/write-line inner (- (:h inner) 1)
                   " [jk] select  [space] add  [x] remove last  [enter] confirm  [esc] cancel"
                   [80 80 80] panel-bg))))

;; --- Public API ---

(defn render-hazard-prompt
  "Render a y/n confirmation prompt centred on the screen's bottom row. A
   `hint` takes the place of the plain \"(y/n)\" and names the keys itself."
  ([world prompt] (render-hazard-prompt world prompt nil))
  ([world prompt hint]
  (let [[tw th] (term-dims)
        msg (if hint (str prompt " " hint) (str prompt " (y/n)"))
        msg (if (> (count msg) tw) (subs msg 0 tw) msg)
        y th]
    (term/move-cursor 1 y)
    (term/set-fg 255 200 60)
    (term/set-bg 40 20 10)
    (term/write (apply str (repeat tw " ")))
    (term/move-cursor (inc (quot (- tw (count msg)) 2)) y)
    (term/write msg)
    (term/flush))))

(declare render-full render-dirty)


;; --- Hazard panel ---
;; The hazard prompt's warning, drawn in a small box beside the player rather
;; than only on the bottom row, which is out of the eye's way. The bottom row
;; keeps the alert and carries the hint (render-hazard-prompt).

(def ^:private hazard-panel-colors
  {:water {:fg [130 190 245] :bg [12 22 38]}
   :fall  {:fg [185 170 215] :bg [22 18 30]}
   :fire  {:fg [250 150 80]  :bg [38 16 8]}})
(def ^:private hazard-warn-color [255 205 70])

(defn- hazard-panel-lines [world]
  [(str "⚠ " (or (:hazard-prompt world) "Are you sure?"))
   "y / n"])

(defn hazard-panel-rect
  "Where the hazard panel goes, in terminal cells: {:x :y :w :h}, or nil if
   it doesn't fit. Below the player with a row between, so the cell under the
   player stays in view, or above when the hazard is below the player (the
   step being confirmed stays uncovered) or there is no room below. Centred
   on the player, kept inside the map rect `mr`. `at` is the player's
   terminal cell; `dy` the pending step's vertical direction."
  [mr [px py] dy w h]
  (let [below (+ py 2)
        above (- py 1 h)
        fits? (fn [y] (and (>= y (:y mr)) (<= (+ y h) (+ (:y mr) (:h mr)))))
        y (cond
            (and (<= dy 0) (fits? below)) below
            (fits? above) above
            (fits? below) below)
        x (-> (- px (quot w 2))
              (min (- (+ (:x mr) (:w mr)) w))
              (max (:x mr)))]
    (when (and y (<= w (:w mr)))
      {:x x :y y :w w :h h})))

(defn- hazard-panel-placement
  "[rect lines map-rect] for the hazard panel of `world`, or nil."
  [world]
  (when-let [[px py] (get-in world [:entities :player :pos])]
    (let [[tw th] (term-dims)
          mr (with-camera world (:map (ui/layout tw th)))
          at (map-cell mr px py)
          lines (hazard-panel-lines world)
          w (+ 4 (reduce max (map count lines)))]
      (when at
        ;; no padding rows: the panel sits next to the player and must stay small
        (when-let [rect (hazard-panel-rect mr at (or (:hazard-dy world) 0) w (+ 2 (count lines)))]
          [rect lines mr])))))

(defn render-hazard-panel
  "Draw the hazard panel beside the player, tinted by the hazard's element."
  [world]
  (when-let [[rect lines _] (hazard-panel-placement world)]
    (let [tile (when-let [[x y] (:hazard-pos world)]
                 (terrain/tget (:terrain world) (:width world) x y))
          {:keys [fg bg]} (get hazard-panel-colors
                               (:element (get terrain/hazard-info tile))
                               (:water hazard-panel-colors))
          inner (ui/box rect nil fg bg)]
      (ui/write-at inner 1 0 (first lines) fg bg)
      ;; the warning sign in amber, over the tinted first line
      (ui/write-at inner 1 0 "⚠" hazard-warn-color bg)
      ;; the answer keys in a whiter tint of the panel's colour, "/" in its own
      (let [x0 (- (:w inner) 1 (count (second lines)))
            keys-fg (mapv #(int (+ % (* 0.6 (- 255 %)))) fg)]
        (ui/write-at inner x0 1 (second lines) fg bg)
        (ui/write-at inner x0 1 "y" keys-fg bg)
        (ui/write-at inner (+ x0 4) 1 "n" keys-fg bg))
      (pen-reset!))))

(defn- restore-map-rect!
  "Redraw the map cells under terminal rect `rect` from `world`, as render-map
   would, so whatever was drawn over them is gone."
  [world mr rect]
  (let [{:keys [terrain width height fov memory]} world
        cx (or (:cx mr) 0)
        cy (or (:cy mr) 0)]
    (pen-reset!)
    (doseq [row (range (:y rect) (+ (:y rect) (:h rect)))
            col (range (:x rect) (+ (:x rect) (:w rect)))]
      (let [x (+ cx (- col (:x mr)))
            y (+ cy (- row (:y mr)))]
        (if-not (and (>= x 0) (< x width) (>= y 0) (< y height))
          ;; past the world's edge: render-map leaves these to the full clear
          (do (term/move-cursor col row)
              (let [[br bgg bb] ui/bg] (pen-bg! br bgg bb))
              (term/write " "))
          (let [visible (contains? fov [x y])]
            ;; the buffer still holds what was there before the panel
            (swap! cell-appearance dissoc [x y])
            (render-map-tile mr x y
                             (when visible (terrain/tget terrain width x y))
                             visible (get memory [x y])
                             (when visible (light-of world x y))
                             (when visible (get (:stains world) [x y]))
                             (when visible (get (:gases world) [x y])))))))))


(defn- overlaps? [a b]
  (and (< (:x a) (+ (:x b) (:w b))) (< (:x b) (+ (:x a) (:w a)))
       (< (:y a) (+ (:y b) (:h b))) (< (:y b) (+ (:y a) (:h a)))))

(defn close-panel!
  "Take down the panel last drawn over the game, redrawing only what it
   covered: the map cells and what stands on them, and any side region it
   touched. An action taken from the panel (equip, use) spends a turn, so
   whatever else changed since `prev-world`, when the panel opened, is drawn
   as after a move. Falls back to a full repaint if no panel was recorded."
  [world prev-world]
  (if-let [rect @open-panel-rect]
    (let [[tw th] (term-dims)
          panels (ui/layout tw th)
          mr (with-camera world (:map panels))]
      (reset! open-panel-rect nil)
      (reset! sidebar-drawn nil)
      (sfx/with-frame
        (ui/apply-bg ui/bg)
        (ui/apply-fg ui/bg)
        (dotimes [i (:h rect)]
          (term/move-cursor (:x rect) (+ (:y rect) i))
          (term/write (apply str (repeat (:w rect) " "))))
        (restore-map-rect! world mr rect)
        (render-map-entities world mr)
        (doseq [[k f] [[:topbar render-topbar] [:sidebar render-sidebar]
                       [:log render-log] [:status render-status]]]
          (when-let [pr (get panels k)]
            (when (overlaps? pr rect) (f world pr))))
        (render-dirty world prev-world)))
    (render-full world)))
(defn erase-prompt!
  "Take down a bottom-row prompt (render-hazard-prompt) and bring the screen
   from `prev-world`, which is still on it, up to `world`. The prompt painted
   over the screen rather than repainting it, so only its row and what the
   answer changed need drawing. A full repaint only where the map itself
   reaches that row, or when the answer left the game screen (a floor change,
   death)."
  [world prev-world]
  (let [[tw th] (term-dims)
        m (:map (ui/layout tw th))]
    (if (or (not= (:depth world) (:depth prev-world))
            (contains? #{:death} (:screen world))
            (and m (<= (:y m) th) (< th (+ (:y m) (:h m)))))
      (render-full world)
      ;; one frame, so the status line is never seen blank
      (sfx/with-frame
        (ui/apply-bg ui/bg)
        (ui/apply-fg ui/bg)
        (term/move-cursor 1 th)
        (term/write (apply str (repeat tw " ")))
        ;; the panel beside the player, if the prompt had one
        (when (:hazard-pos prev-world)
          (when-let [[rect _ mr] (hazard-panel-placement prev-world)]
            (restore-map-rect! world mr rect)))
        (render-dirty world prev-world)))))

(defn render-full [world]
  (let [[tw th] (term-dims)
        panels (ui/layout tw th)
        mr (with-camera world (:map panels))]
    (reset! sidebar-drawn nil)
    (sfx/with-frame
    ;; blank entire terminal with bg color
    (ui/apply-bg ui/bg)
    (ui/apply-fg ui/bg)
    (dotimes [y th]
      (term/move-cursor 1 (inc y))
      (term/write (apply str (repeat tw " "))))
    ;; render panels
    (render-map world mr)
    (render-map-entities world mr)
    (render-topbar world (:topbar panels))
    (render-sidebar world (:sidebar panels))
    (render-log world (:log panels))
    (render-status world (:status panels)))
    (commit-camera! world mr)))

(defn render-dirty [world prev-world]
  (let [[tw th] (term-dims)
        panels (ui/layout tw th)
        ;; Camera-change detection must compare against the camera that
        ;; was actually drawn last frame (@last-camera), not a recomputed
        ;; one from prev-world: with-camera prev-world and with-camera
        ;; world both call camera-for against the same atom and yield
        ;; identical results when the dead-zone returns the same answer
        ;; for both player positions — so the original comparison never
        ;; fired across real camera shifts, leaving a 1-row ghost behind
        ;; the incremental render.
        mr       (with-camera world (:map panels))
        old-fov  (:fov prev-world)
        new-fov  (:fov world)
        prev-cam (or @last-camera mr)]
    (sfx/with-frame
    (if (or (not= (:cx prev-cam) (:cx mr))
            (not= (:cy prev-cam) (:cy mr)))
      ;; Camera shifted — viewport contents moved; redraw map fully.
      (do (render-map world mr)
          (render-map-entities world mr)
          (render-topbar world (:topbar panels))
          (render-sidebar world (:sidebar panels))
          (render-log world (:log panels))
          (render-status world (:status panels)))
      ;; Camera held — FOV-delta path. map-cell handles visibility check;
      ;; no outer bounds guard needed because x,y are world coords.
      ;; Each cell is drawn once as it finally looks, its top entity or its tile,
      ;; through the appearance buffer (see render-entity). A monster that moved
      ;; changes both its old cell (now the tile) and its new one, so the diff
      ;; repaints exactly those; one that stood still costs nothing.
      (let [top (top-entities world)]
        ;; Iterate in the original FOV-set order (not sorted): fire/water/lava
        ;; draw their color from the global rand stream in tile-appearance, so
        ;; reordering would reshuffle which cell consumes which draw. Harmless
        ;; (that stream is unseeded — shimmer varies run to run anyway) but a
        ;; needless behavior change, so keep base order.
        (pen-reset!)   ; start of the FOV-delta penned batch (see sgr-pen)
        (doseq [[x y] old-fov]
          (when-not (contains? new-fov [x y])
            (render-cell! world mr top x y)))
        (doseq [[x y] new-fov]
          (render-cell! world mr top x y))
        (let [[opx opy] (get-in prev-world [:entities :player :pos])]
          (when (and opx opy)
            (render-cell! world mr top opx opy)))
        (render-topbar world (:topbar panels))
        (render-sidebar world (:sidebar panels))
        (render-log world (:log panels))
        (render-status world (:status panels)))))
    (commit-camera! world mr)))

;; --- Frame capture (the arrival fade-in) ---
;; render-full costs 100-170 ms on Go wasm, nearly all of it computing the
;; frame (lighting, memory, camera), not emitting it. The arrival fades the
;; first frame in at 25 fps, so it renders once with the terminal calls
;; recorded, and redraws only the cells that show something at each step's
;; brightness: 60-250 cells on a first floor, 2-7 ms a frame (2026-11-24).

(defn- in-rect? [r x y]
  (and r (>= x (:x r)) (< x (+ (:x r) (:w r)))
         (>= y (:y r)) (< y (+ (:y r) (:h r)))))

(defn capture-frame
  "Render `world` as render-full would, without drawing it, and return the
   visible cells as [{:x :y :s :fg :bg :part}]. A write that is blank on the
   background is left out: the screen is already that. :part is the panel the
   cell falls in (:map, :log, :side for the sidebar, top bar and status line),
   or :quest for a log line that starts one of `quest-lines`.

   A bound xsofy.gentick/*tick* (the descent's) is called per map row, and
   what it draws goes to the screen, not into the capture: the render takes
   ~150 ms, longer than the audio queue lasts without the thread."
  [world quest-lines]
  (let [[tw th] (term-dims)
        panels (ui/layout tw th)
        ops (atom [])
        cur (atom {:x 1 :y 1 :fg ui/bg :bg ui/bg})
        real {:move term/move-cursor :fg term/set-fg :bg term/set-bg :write term/write}
        live? (atom false)
        outer gt/*tick*]
    (with-redefs [term/move-cursor (fn [x y]
                                     (if @live? ((:move real) x y) (swap! cur assoc :x x :y y))
                                     nil)
                  term/set-fg (fn [r g b]
                                (if @live? ((:fg real) r g b) (swap! cur assoc :fg [r g b]))
                                nil)
                  term/set-bg (fn [r g b]
                                (if @live? ((:bg real) r g b) (swap! cur assoc :bg [r g b]))
                                nil)
                  term/write (fn [s]
                               (if @live?
                                 ((:write real) s)
                                 (let [{:keys [x y fg bg]} @cur]
                                   (when-not (and (= bg ui/bg) (str/blank? s))
                                     (swap! ops conj {:x x :y y :s s :fg fg :bg bg}))
                                   (swap! cur update :x + (count s))))
                               nil)]
      (binding [gt/*tick* (when outer
                            (fn [done]
                              (reset! live? true)
                              (try (outer done) (finally (reset! live? false)))))]
        (render-full world)))
    ;; the pen recorded colors that were never sent
    (pen-reset!)
    (let [quest? (fn [s] (let [t (str/trim s)]
                           (and (seq t) (some #(str/starts-with? % t) quest-lines))))]
      (mapv (fn [{:keys [x y s] :as c}]
              (assoc c :part
                     (cond
                       (in-rect? (:map panels) x y) :map
                       (in-rect? (:log panels) x y) (if (quest? s) :quest :log)
                       :else :side)))
            @ops))))
