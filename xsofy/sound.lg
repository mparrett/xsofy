(ns xsofy.sound
  (:require [xsofy.util :as u]
            [xsofy.det :as det]
            [math]))

;; --- Sound System ---
;; Entities emit sounds. The system delivers them as messages
;; based on distance from the player. Sounds have:
;;   :msg-near  — player can see the source
;;   :msg-mid   — close but not visible (behind wall)
;;   :msg-far   — distant
;;   :radius    — max hearing distance
;;   :pos       — where it happened

(def near-threshold 3)
(def mid-threshold 8)

(def distance u/distance)

;; --- The :sfx outbox -------------------------------------------------------
;; Alongside the text messages, deliver-sound appends an audio event
;; descriptor to (:sfx world) — a per-turn outbox exactly like :vfx: the
;; presentation seam (xsofy.play) drains it into the emitted audio frame and
;; dissoc's it, so it never survives a turn and never reaches saves, the hash
;; chain, or replay. Descriptors are declarative — {:kind :dist :dir} says
;; what happened, never how it sounds (xsofy.sfx owns that mapping).
;; Appending consumes no rng; the spatial data is what deliver-sound already
;; computes for its near/mid/far text.

(defn cue
  "Append a non-spatial audio event (the player's own action — a pickup, a
   hit landing on them). dist 0, centered."
  [world kind]
  (update world :sfx #(conj (or % []) {:kind kind :dist 0})))

(defn- audio-event
  "The outbox append for a spatial sound, from the delivery math."
  [world sound player-pos dist]
  (if-let [kind (:kind sound)]
    (let [[px _] player-pos
          [sx _] (:pos sound)
          ;; horizontal offset normalized by distance: -1..1, left..right
          dir (if (pos? dist) (/ (double (- sx px)) (max 1.0 (double dist))) 0.0)]
      (update world :sfx #(conj (or % []) {:kind kind :dist dist :dir dir})))
    world))

(defn deliver-sound [world sound]
  (let [player-pos (get-in world [:entities :player :pos])
        fov (or (:fov world) #{})
        spos (:pos sound)
        dist (if (and player-pos spos) (distance player-pos spos) 999)
        radius (or (:radius sound) 15)
        visible (contains? fov spos)]
    (if (> dist radius)
      world ;; too far to hear
      (let [world (audio-event world sound player-pos dist)
            msg (cond
                  visible           (:msg-near sound)
                  (< dist mid-threshold) (:msg-mid sound)
                  :else             (:msg-far sound))]
        (if msg
          (update world :log #(conj (or % []) msg))
          world)))))

(defn deliver-sounds [world sounds]
  (reduce deliver-sound world sounds))

;; --- Sound Definitions ---

(defn footstep [pos who]
  {:kind :footstep
   :pos pos :radius 10
   :msg-near nil  ;; you can see them, no need for sound
   :msg-mid  (str "You hear footsteps.")
   :msg-far  (str "You hear distant footsteps.")})

(defn door-open [pos who]
  {:kind :door
   :pos pos :radius 15
   :msg-near (str "The " who " opens a door.")
   :msg-mid  "You hear hinges creak."
   :msg-far  "You hear a distant creak."})

(defn snoring [pos who]
  {:kind :idle
   :pos pos :radius 8
   :msg-near (str "The " who " is snoring.")
   :msg-mid  "You hear snoring."
   :msg-far  nil})

;; --- Default death/combat sounds ---

(defn death-cry [pos who]
  {:kind :death
   :pos pos :radius 20
   :msg-near (str "The " who " shrieks and falls!")
   :msg-mid  "You hear a shriek!"
   :msg-far  "You hear a distant shriek."})

(defn combat-hit [pos who target]
  {:kind :combat-hit
   :pos pos :radius 12
   :msg-near nil
   :msg-mid  "You hear fighting."
   :msg-far  "You hear distant fighting."})

;; --- Per-creature sound tables ---
;; Each creature can have :sounds on its template:
;;   {:death {:near "..." :mid "..." :far "..."}
;;    :idle  [{:near "..." :mid "..." :far "..." :chance 5}]}

(defn creature-death [pos who sounds]
  (let [d (:death sounds)]
    (if d
      {:kind :death
       :pos pos :radius 20
       :msg-near (or (:near d) (str "The " who " dies."))
       :msg-mid  (or (:mid d) "You hear something die.")
       :msg-far  (:far d)}
      (death-cry pos who))))

(defn creature-idle-det
  "Deterministic creature idle sound. Returns [sound-or-nil world']."
  [world creature-id pos who sounds]
  (let [options (:idle sounds)]
    (if-not (and options (seq options))
      [nil world]
      (let [w (det/with-context world [:fx :creature-idle creature-id])
            [pick-idx w] (det/int-in w 0 (count options))
            pick (nth options pick-idx)
            [hit? w] (det/percent? w (or (:chance pick) 5))]
        (if hit?
          [{:kind :idle
            :pos pos :radius (or (:radius pick) 10)
            :msg-near (:near pick)
            :msg-mid  (:mid pick)
            :msg-far  (:far pick)}
           w]
          [nil w])))))
