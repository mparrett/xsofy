(ns xsofy.console
  "Quake-style dev console: a live let-go REPL/harness against the running game.

   It is a game-side :screen (see xsofy.main game-loop), driven through the same
   poll-based event loop (xsofy.ui/run-loop) as every other screen, so it works
   identically in the native TUI and in the browser (wasm) with no shell change
   and no build flag — the shipped bundle already carries the reader + `eval`.

   The console owns the world while open (like the death screen) and returns it
   — possibly mutated — on close. It is an explicit dev escape hatch, gated
   behind a dev flag (see xsofy.input/dev? + the backtick binding).

   Determinism guard (best-effort). Console access bypasses dispatch (no seed
   fold, no :action-log), so it can't be reconstructed by replaying actions. Any
   live-world access (via `w`, hence any read OR mutation) sets :console-tainted?
   — conservative on purpose: we can't distinguish a read from an in-place array
   mutation, so we never miss one. On close we append a `taint-marker` sentinel
   to :action-log; replay stops there, so the run reconstructs faithfully up to
   the console touch and no further (xsofy.replay encode-run/decode truncate at
   it; xsofy.dispatch treats it as a stop). The guard is best-effort — arbitrary
   eval can still perturb determinism through non-world channels (alter-var-root,
   globals, wall-clock), which no cheap guard catches. The principled end state
   is to record console interventions as commits in the game-state DAG
   (xsofy.dag), which already anticipates this as its 'external injection' case
   (checkpoint-hash / world-checkpoint anchoring) — a console commit would store
   a checkpoint and re-anchor replay from it, reproducing the intervention in
   full. That's gated on the DAG becoming the live dispatch path.

   Symbols typed at the prompt resolve in THIS namespace, so the :require aliases
   below (world/…, entities/…, render/…) and the convenience mutators (hp!, heal,
   tp, depth!, log, w, w!, player) are all callable unqualified from the REPL."
  (:require [term]
            [pprint]
            [xsofy.world :as world]
            [xsofy.entities :as entities]
            [xsofy.render :as render]
            [xsofy.ui :as ui]))

;; --- Key constants --------------------------------------------------------
;; Built from (char N) so the source stays plain ASCII (no invisible control
;; bytes in the file). ESC-prefixed sequences are what term/read-key returns
;; for the arrow / nav keys.

(def ^:private ESC (str (char 27)))
(def ^:private DEL (str (char 127)))
(def ^:private BS  (str (char 8)))
(def ^:private ETX (str (char 3)))        ;; Ctrl-C
(def ^:private K-LEFT  (str ESC "[D"))
(def ^:private K-RIGHT (str ESC "[C"))
(def ^:private K-UP    (str ESC "[A"))
(def ^:private K-DOWN  (str ESC "[B"))
(def ^:private K-HOME  (str ESC "[H"))
(def ^:private K-END   (str ESC "[F"))
(def ^:private K-PGUP  (str ESC "[5~"))
(def ^:private K-PGDN  (str ESC "[6~"))

;; --- Eval bridge ----------------------------------------------------------
;; A module-level cell seeded per eval. Mutators stage the next world into it
;; via w!, so we don't depend on dynamic-binding surviving across the `eval`
;; frame boundary — eval-line seeds it, runs the form, then reads it back.

(def ^:private repl (atom {:world nil :tainted? false}))

;; Split render signatures so we repaint the minimum. last-panel covers the
;; scrollback/border (redrawn only when output/scroll/size/taint change);
;; last-prompt covers the input line (redrawn on every keystroke). Typing only
;; rewrites the ONE prompt row — a single-row overwrite doesn't flicker, so the
;; console stays smooth without any terminal synchronized-output support. Both
;; reset per open so the first frame always paints. See render-console.
(def ^:private last-panel  (atom nil))
(def ^:private last-prompt (atom nil))

;; The sentinel appended to :action-log when the console touched the live world.
;; It rides the replay wire format as a plain keyword (no format change); replay
;; stops at it, so a console-touched run reconstructs faithfully up to that point
;; and no further. See xsofy.replay (encode-run / decode) and xsofy.dispatch.
(def taint-marker :console-taint)

(defn w
  "The current working world inside a console eval. Reading it TAINTS the run:
   we can't tell a read from an in-place mutation of the live world (e.g.
   (aset (:terrain (w)) …)), so any access is treated as non-deterministic. This
   is the conservative-but-sound guard — it never misses a mutation, at the cost
   of tainting pure reads too (which only truncates the replay at that point)."
  [] (swap! repl assoc :tainted? true) (:world @repl))

(defn w!
  "Stage `nw` as the new world and mark the run tainted (non-deterministic).
   Returns nw so it composes in a threaded form."
  [nw] (swap! repl assoc :world nw :tainted? true) nw)

(defn mark-tainted
  "Append the taint sentinel to `world`'s :action-log once, at the current turn
   boundary, so replay truncates the run here. No-op if the run isn't tainted or
   the sentinel is already present (a re-opened console keeps the earliest mark)."
  [world]
  (if (and (:console-tainted? world)
           (not (some #{taint-marker} (:action-log world))))
    (update world :action-log (fnil conj []) taint-marker)
    world))

;; --- Convenience mutators / inspectors (callable unqualified at the prompt) ---

(defn player [] (get-in (w) [:entities :player]))

;; Mutators stage the new world via w! (side effect) but return a SMALL
;; confirmation value — not the world — so pr-str at the prompt stays readable.
;; hp! also raises max-hp to >= n so the set value survives the next turn's
;; hp<=max-hp clamp (otherwise (hp! 999) snaps back to max on the following turn).
(defn hp!    [n] (w! (-> (w)
                         (assoc-in [:entities :player :body :hp] n)
                         (update-in [:entities :player :body :max-hp]
                                    (fn [m] (max (or m 0) n))))) n)
(defn heal   [] (let [mh (get-in (w) [:entities :player :body :max-hp])]
                  (w! (assoc-in (w) [:entities :player :body :hp] mh)) mh))
(defn tp     [x y] (w! (assoc-in (w) [:entities :player :pos] [x y])) [x y])
(defn depth! [n] (w! (assoc (w) :depth n)) n)
(defn log    [msg] (w! (world/log-msg (w) (str msg))) :ok)

(defn eval-line
  "Read + eval `line` as let-go forms in this namespace against `world`. Returns
   {:ok bool :val <string> :world world' :tainted? bool}. Wraps in (do …) so
   multi-form input works; parse/eval errors are caught and reported, never
   thrown, so a bad line can't kill the console loop."
  [world line]
  (reset! repl {:world world :tainted? false})
  (let [prev (ns-name *ns*)]
    (in-ns 'xsofy.console)
    (let [r (try
              ;; pprint-str indents maps/vectors over multiple lines but collapses
              ;; small values back to one line, so (player) reads nicely while
              ;; (+ 1 2) stays "3". submit splits the result on newlines into rows.
              {:ok true  :val (pprint/pprint-str (eval (read-string (str "(do " line "\n)"))))}
              (catch e {:ok false :val (str e)}))]
      (in-ns prev)
      (assoc r :world (:world @repl) :tainted? (:tainted? @repl)))))

;; --- Console state --------------------------------------------------------

(defn init-state
  "Seed the run-loop state for the console screen from the live `world`."
  [world size]
  (reset! last-panel nil)    ;; force a first full paint; clear any prior session
  (reset! last-prompt nil)
  {:world world :size size :frame 0
   :input "" :cursor 0
   :history [] :hist-idx nil
   :output [{:s "let-go dev console — type a form, Enter to eval, Esc/` to close" :k :note}]
   :scroll 0})

;; A length-1 key that is NOT one of these control strings is printable input
;; (covers typed ASCII and rune glyphs); avoids char-code arithmetic. Multi-byte
;; escape sequences (arrows etc.) are length > 1, so they're excluded already.
(def ^:private control-keys
  #{"\r" "\n" "\t" ESC DEL BS ETX})

(defn- printable? [k]
  (and (string? k) (= 1 (count k)) (not (contains? control-keys k))))

(defn- record
  "Append a scrollback line and reset scroll to the bottom."
  [st s k] (-> st (update :output conj {:s s :k k}) (assoc :scroll 0)))

(defn- record-lines
  "Record a possibly-multi-line string as one scrollback row per line, so
   pretty-printed (indented) values keep their layout in the panel."
  [st s k]
  (reduce (fn [st ln] (record st ln k)) st (split (str s) "\n")))

(defn- submit
  "Evaluate the current input line, record the echo + result, adopt any staged
   world, and push the line to history."
  [st]
  (let [line (:input st)]
    (if (= 0 (count line))
      (assoc st :hist-idx nil)
      (let [{:keys [ok val world tainted?]} (eval-line (:world st) line)
            world (if tainted? (assoc world :console-tainted? true) world)
            st (-> st
                   (record (str "» " line) :in)
                   (record-lines (str val) (if ok :ok :err))
                   (assoc :world world
                          :input "" :cursor 0
                          :hist-idx nil
                          :history (conj (:history st) line)))]
        ;; Only repaint the game beneath when the eval actually changed world
        ;; state — a read-only form like (player) leaves the game untouched, so
        ;; there's nothing to redraw (and no needless full-screen repaint).
        (when tainted? (render/render-full world))
        st))))

(defn- recall
  "History up/down. dir -1 = older, +1 = newer."
  [st dir]
  (let [h (:history st)
        n (count h)]
    (if (= 0 n)
      st
      (let [idx (:hist-idx st)
            idx' (cond
                   (= dir -1) (if (nil? idx) (dec n) (max 0 (dec idx)))
                   :else      (if (nil? idx) nil (inc idx)))]
        (if (or (nil? idx') (>= idx' n))
          (assoc st :input "" :cursor 0 :hist-idx nil)
          (let [line (nth h idx')]
            (assoc st :input line :cursor (count line) :hist-idx idx')))))))

(defn- edit
  "Apply a raw printable/editing key to the input line."
  [st k]
  (let [in (:input st) c (:cursor st)]
    (cond
      (printable? k)
      (assoc st :input (str (subs in 0 c) k (subs in c)) :cursor (inc c))

      (or (= k DEL) (= k BS))                        ;; Backspace / Del
      (if (> c 0)
        (assoc st :input (str (subs in 0 (dec c)) (subs in c)) :cursor (dec c))
        st)

      (= k K-LEFT)  (assoc st :cursor (max 0 (dec c)))
      (= k K-RIGHT) (assoc st :cursor (min (count in) (inc c)))
      (= k K-HOME)  (assoc st :cursor 0)
      (= k K-END)   (assoc st :cursor (count in))
      (= k K-UP)    (recall st -1)
      (= k K-DOWN)  (recall st 1)
      (= k K-PGUP)  (update st :scroll inc)
      (= k K-PGDN)  (update st :scroll (fn [s] (max 0 (dec s))))
      :else st)))

(defn handle-key
  "run-loop :step for the console. [:action k] edits the line / submits / closes;
   [:tick f] advances the cursor-blink frame (and repaints the game on resize).
   Returns state, or (reduced world') to close (returning the possibly-mutated
   world to the game-loop)."
  [st ev]
  (let [[tag payload] ev]
    (case tag
      :action
      (let [k payload]
        (cond
          (or (= k ESC) (= k "`")) (reduced (mark-tainted (:world st)))  ;; Esc / ` close
          (= k :eof)                    (reduced (mark-tainted (:world st)))
          (or (= k "\r") (= k "\n"))    (submit st)
          :else                          (edit st k)))
      :tick
      (let [sz (term/size)]
        (if (= sz (:size st))
          (assoc st :frame payload)
          (do (render/render-full (:world st))         ;; resized: repaint beneath
              (assoc st :frame payload :size sz))))
      st)))

;; --- Render (the drop-down panel) -----------------------------------------
;; Opaque panel over the top of the terminal; the game (painted by the caller
;; on entry, and by handle-key on mutation/resize) shows below it — the Quake
;; drop-down look. We only ever repaint the top rows here.

(def ^:private border [120 180 140])
(def ^:private fg-in  [150 150 100])
(def ^:private fg-ok  [180 210 170])
(def ^:private fg-err [230 130 120])
(def ^:private fg-txt [210 205 180])

(defn- line-fg [k]
  (case k :in fg-in :ok fg-ok :err fg-err fg-txt))

(defn- draw-prompt
  "Write the prompt line (» input) and a steady inverted block cursor into the
   panel's inner rect. This is the ONLY thing a keystroke repaints — one row."
  [inner input c]
  (let [prow (dec (:h inner))
        col (+ 2 c)
        ch (if (< c (count input)) (subs input c (inc c)) " ")]
    (ui/write-line inner prow (str "» " input) fg-txt ui/bg)
    (ui/write-at inner col prow ch ui/bg fg-txt)))   ;; inverted cell

(defn render-console
  "Repaint the minimum. When the scrollback / scroll / size / taint changes
   (eval, scroll, resize) redraw the whole panel; otherwise — the common case,
   typing — rewrite only the prompt row. A single-row overwrite doesn't flash,
   so typing stays smooth with no synchronized-output dependency. Idle frames
   change nothing, so both branches no-op."
  [st]
  (let [[tw th] (or (:size st) (term/size))
        tainted? (get-in st [:world :console-tainted?])
        ph (min th (max 10 (quot th 2)))
        ;; matches ui/box's inner rect for r=(rect 1 1 tw ph): (rect 2 2 w-2 h-2)
        inner (ui/rect 2 2 (- tw 2) (- ph 2))
        panel-sig  [(:scroll st) (count (:output st)) tw th tainted?]
        prompt-sig [(:input st) (:cursor st)]]
    (cond
      (not= panel-sig @last-panel)
      (do (reset! last-panel panel-sig)
          (reset! last-prompt prompt-sig)
          (let [r (ui/rect 1 1 tw ph)
                title (str "let-go repl" (when tainted? "  [TAINTED]"))]
            (ui/clear-rect r)
            (let [box-inner (ui/box r title border ui/bg)
                  h (:h box-inner)
                  vis (max 1 (dec h))              ;; rows for scrollback (last = prompt)
                  out (:output st)
                  n (count out)
                  s (:scroll st)
                  start (max 0 (- n vis s))
                  end (min n (+ start vis))
                  shown (subvec out start end)]
              (dotimes [i (count shown)]
                (let [e (nth shown i)]
                  (ui/write-line box-inner i (str " " (:s e)) (line-fg (:k e)) ui/bg)))
              (draw-prompt box-inner (:input st) (:cursor st))))
          (term/flush))

      (not= prompt-sig @last-prompt)
      (do (reset! last-prompt prompt-sig)
          (draw-prompt inner (:input st) (:cursor st))
          (term/flush)))))
