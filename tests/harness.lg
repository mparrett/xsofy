(ns tests.harness)

;; Minimal test harness — let-go's clojure.test is broken (*testing-vars* doesn't
;; resolve), so we roll our own.
;;
;; Macros must be called via the alias (e.g. `(h/is ...)`) and use the fully
;; qualified `tests.harness/...` for their generated calls — that's the only
;; cross-namespace pattern let-go honors reliably.

(def passed (atom 0))
(def failed (atom 0))
(def failures (atom []))

(defn pass! [] (swap! passed inc))

(defn fail! [label form-str]
  (swap! failed inc)
  (swap! failures conj (str label " — " form-str)))

(defmacro is
  "Assert expr is truthy. On failure, record the source form."
  [expr]
  `(let [r# ~expr]
     (if r#
       (tests.harness/pass!)
       (tests.harness/fail! "is" (pr-str '~expr)))))

(defmacro is=
  "Assert (= expected actual). Records both values on failure."
  [expected actual]
  `(let [e# ~expected
         a# ~actual]
     (if (= e# a#)
       (tests.harness/pass!)
       (tests.harness/fail! "is=" (str (pr-str '~actual)
                                       "  expected " (pr-str e#)
                                       "  got "      (pr-str a#))))))

(defmacro group
  "Print a labelled section header and run the body."
  [label & body]
  `(do (println (str "  · " ~label)) ~@body))

(defn report-and-exit []
  (let [p @passed
        f @failed
        total (+ p f)]
    (println)
    (println (str "tests: " total "  passed: " p "  failed: " f))
    (doseq [msg @failures]
      (println (str "    FAIL: " msg)))
    (os/exit (if (zero? f) 0 1))))
