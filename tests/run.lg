;; Entry point. Run from the repo root:
;;
;;     lg tests/run.lg
;;
;; Exit code is 0 on full pass, 1 on any failure — suitable for CI.
;;
;; Note: this file deliberately has no (ns ...) form. lg evaluates a file with
;; a ns declaration TWICE (once as a script, once as a namespace load), which
;; would double-run the suite. A bare script runs cleanly once.

(require 'tests.harness)
(require 'tests.runes)
(require 'tests.world)

(tests.harness/report-and-exit)
