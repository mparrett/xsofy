(ns tests.runes
  (:require [test :refer :all]
            [xsofy.runes :as r]))

;; parse-runes compiles a flat rune sequence into pipeline steps.
;; See xsofy/runes.lg and docs/spell-dsl.md.

(deftest parse-single-primitive
  (is (= [:fire] (r/parse-runes [:fire]))))

(deftest parse-two-step-pipeline
  (is (= [:fire :ice] (r/parse-runes [:fire :ice]))))

(deftest parse-apply-combinator
  ;; The textbook example from the rune-system docstring:
  ;; (apply fire 3) ice → fire(3), then ice.
  (is (= [[:fire 3] :ice] (r/parse-runes [:apply :fire 3 :ice]))))

(deftest parse-math-reduces-inline
  (is (= [6 :fire] (r/parse-runes [:mul 2 3 :fire]))))

(deftest parse-bad-math-arg-surfaces-error
  (let [steps (r/parse-runes [:mul :fire 3])
        step  (first steps)]
    (is (map? step))
    (is (= :bad-argument (:error step)))
    (is (= :mul (:rune step)))))

(deftest generate-rune-table-covers-all-primitives
  (let [table (r/generate-rune-table)]
    (is (= (count r/all-runes) (count table)))
    (is (every? string? (mapv :glyph (vals table))))))
