(ns tests.world
  (:require [test :refer :all]
            [xsofy.world :as w]))

;; make-world generates a floor, a player, starting items, and a rune table.
;; update-world is the per-turn reducer. :wait advances the turn
;; unconditionally without depending on terrain, so it's the safest action
;; to exercise here.

(deftest make-world-produces-live-player-at-depth-1
  (let [world  (w/make-world 30 20)
        player (get-in world [:entities :player])
        hp     (get-in player [:body :hp])]
    (is (= 1 (:depth world)))
    (is (= 0 (:turn world)))
    (is (vector? (:pos player)))
    (is (and (number? hp) (pos? hp)))))

(deftest make-world-gives-player-starting-inventory
  (let [player (get-in (w/make-world 30 20) [:entities :player])]
    (is (seq (:inventory player)))))

(deftest wait-action-advances-turn-without-harming-player
  (let [w0  (w/make-world 30 20)
        w1  (w/update-world w0 :wait)
        hp0 (get-in w0 [:entities :player :body :hp])
        hp1 (get-in w1 [:entities :player :body :hp])]
    (is (= (inc (:turn w0)) (:turn w1)))
    (is (some? (get-in w1 [:entities :player])))
    ;; Resting one turn on a fresh floor shouldn't lose HP.
    (is (= hp0 hp1))))
